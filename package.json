{
  "name": "mediagenda",
  "version": "1.0.0",
  "description": "MediAgenda - Sistema de Agendamento de Consultas Medicas",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:load": "node tests/load/smoke.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restaurar.mjs",
    "icons": "node scripts/gerar-icones-pwa.mjs",
    "setup": "node scripts/preparar-ambiente.mjs",
    "deploy:verificar": "node scripts/verificar-deploy.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.18.2",
    "helmet": "^8.3.0",
    "method-override": "^3.0.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "otplib": "^13.6.0",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.23",
    "@types/express-session": "^1.18.2",
    "@types/method-override": "^3.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "autocannon": "^9.0.0",
    "supertest": "^7.1.4",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
