<section class="page-header">
  <div class="container">
    <a class="small text-decoration-none text-muted" href="/medicos"><i class="bi bi-arrow-left me-1"></i>Voltar a pesquisa</a>
  </div>
</section>

<section class="pb-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="card mb-4">
          <div class="card-body p-4">
            <div class="text-center mb-3">
              <span class="avatar avatar-lg mx-auto mb-3"><%= medico.utilizador.nome.replace('Dr. ', '').replace('Dra. ', '').charAt(0) %></span>
              <h1 class="h4 fw-bold mb-1"><%= medico.utilizador.nome %></h1>
              <div class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i><%= medico.localizacao %></div>
              <div class="mb-2">
                <%- include('../partials/rating', { media: media.media, total: media.total }) %>
              </div>
              <div>
                <% medico.especialidades.forEach(function (vinculo) { %>
                  <span class="specialty-pill mb-1"><%= vinculo.especialidade.nome %></span>
                <% }); %>
              </div>
            </div>

            <% if (medico.bio) { %>
              <p class="small text-muted"><%= medico.bio %></p>
            <% } %>

            <hr />
            <div class="row g-3 small">
              <div class="col-6">
                <div class="text-muted">Registo</div>
                <div class="fw-semibold"><%= medico.numeroRegisto %></div>
              </div>
              <div class="col-6">
                <div class="text-muted">Duração</div>
                <div class="fw-semibold"><%= medico.duracaoConsultaMinutos %> minutos</div>
              </div>
              <div class="col-6">
                <div class="text-muted">Consultas/dia</div>
                <div class="fw-semibold">Até <%= medico.maxConsultasDia %></div>
              </div>
              <div class="col-6">
                <div class="text-muted">Estado</div>
                <span class="badge badge-soft-success">Disponível</span>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="bi bi-clock-history me-1"></i> Horário semanal</div>
          <div class="card-body">
            <% if (medico.disponibilidades.length) { %>
              <ul class="list-unstyled mb-0 small">
                <% medico.disponibilidades.forEach(function (item) { %>
                  <li class="d-flex justify-content-between py-1 border-bottom">
                    <span><%= diasSemana[item.diaSemana] %></span>
                    <span class="fw-semibold"><%= item.horaInicio %> - <%= item.horaFim %></span>
                  </li>
                <% }); %>
              </ul>
            <% } else { %>
              <p class="small text-muted mb-0">O médico ainda não definiu disponibilidade semanal.</p>
            <% } %>
          </div>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="card mb-4">
          <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
              <div>
                <h2 class="h5 fw-bold mb-1">Escolha a data e o horário</h2>
                <p class="small text-muted mb-0">As vagas são atualizadas em tempo real.</p>
              </div>
              <form action="/medicos/<%= medico.id %>" method="get" class="d-flex gap-2">
                <input class="form-control" type="date" name="data" value="<%= dataSelecionada %>" data-auto-submit aria-label="Escolher data" />
                <button class="btn btn-outline-ma" type="submit" aria-label="Ver vagas na data escolhida" title="Ver vagas"><i class="bi bi-arrow-right"></i></button>
              </form>
            </div>

            <div class="small text-muted mb-2">
              <i class="bi bi-calendar3 me-1"></i><%= formatarDiaSemana(dataSelecionada) %>
            </div>

            <% const slotsDisponiveis = slots.filter(function (slot) { return slot.disponivel; }); %>
            <% if (!slots.length) { %>
              <div class="empty-state py-4">
                <i class="bi bi-calendar-x"></i>
                <p class="mb-1 fw-semibold">Sem vagas neste dia</p>
                <p class="small mb-0">A clínica está fechada ou o médico não atende neste dia. Escolha outra data.</p>
              </div>
              <%- include('../partials/sugestoes-vagas', { proximasVagas: proximasVagas, medico: medico, dataSelecionada: dataSelecionada }) %>
            <% } else { %>
              <form id="formMarcacao" action="/paciente/consultas" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="medicoId" value="<%= medico.id %>" />
                <input type="hidden" name="data" value="<%= dataSelecionada %>" />
                <input type="hidden" name="hora" id="horaSelecionada" value="<%= slotsDisponiveis[0] ? slotsDisponiveis[0].hora : '' %>" />

                <div class="slot-grid mb-4">
                  <% slots.forEach(function (slot, indice) { %>
                    <button
                      class="slot <%= slot.disponivel ? '' : 'opacity-50' %> <%= slot.disponivel && slotsDisponiveis[0] && slot.hora === slotsDisponiveis[0].hora ? 'active' : '' %>"
                      type="button"
                      data-hora="<%= slot.hora %>"
                      <%= slot.disponivel ? '' : 'disabled' %>
                      title="<%= slot.motivo || 'Horário disponível' %>"
                    >
                      <%= slot.hora %>
                    </button>
                  <% }); %>
                </div>

                <% if (slotsDisponiveis.length) { %>
                  <div class="row g-3">
                    <% if (medico.especialidades.length > 1) { %>
                      <div class="col-md-5">
                        <label class="form-label" for="especialidadeId">Especialidade</label>
                        <select class="form-select" id="especialidadeId" name="especialidadeId">
                          <% medico.especialidades.forEach(function (vinculo) { %>
                            <option value="<%= vinculo.especialidadeId %>"><%= vinculo.especialidade.nome %></option>
                          <% }); %>
                        </select>
                      </div>
                    <% } else if (medico.especialidades.length === 1) { %>
                      <input type="hidden" name="especialidadeId" value="<%= medico.especialidades[0].especialidadeId %>" />
                    <% } %>
                    <div class="col-md-<%= medico.especialidades.length > 1 ? '7' : '12' %>">
                      <label class="form-label" for="motivo">Motivo da consulta</label>
                      <input class="form-control" id="motivo" name="motivo" type="text" placeholder="Ex.: dor no peito, check-up anual" maxlength="180" />
                    </div>
                  </div>

                  <% if (!utilizador) { %>
                    <div class="alert alert-info mt-4 mb-0 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                      <span><i class="bi bi-info-circle me-1"></i>Inicie sessão como paciente para concluir a marcação.</span>
                      <a class="btn btn-ma btn-sm" href="/login?next=<%= encodeURIComponent('/medicos/' + medico.id + '?data=' + dataSelecionada) %>">Entrar e marcar</a>
                    </div>
                  <% } else if (utilizador.perfil !== 'PACIENTE') { %>
                    <div class="alert alert-warning mt-4 mb-0">
                      <i class="bi bi-exclamation-triangle me-1"></i>
                      Apenas pacientes podem marcar consultas nesta página. Use a área da secretaria para marcar em nome de um paciente.
                    </div>
                  <% } else { %>
                    <button class="btn btn-ma w-100 py-2 mt-4" type="submit">
                      <i class="bi bi-calendar2-check me-1"></i> Marcar consulta as <span id="horaTexto"><%= slotsDisponiveis[0] ? slotsDisponiveis[0].hora : '' %></span>
                    </button>
                    <p class="small text-muted text-center mt-2 mb-0">
                      A marcação fica pendente até à confirmação. Receberá o link por e-mail ou SMS.
                    </p>
                  <% } %>
                <% } else { %>
                  <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Todos os horários deste dia estão ocupados ou indisponíveis. Escolha outra data ou entre na lista de espera.
                  </div>
                  <%- include('../partials/sugestoes-vagas', { proximasVagas: proximasVagas, medico: medico, dataSelecionada: dataSelecionada }) %>
                <% } %>
              </form>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-chat-square-quote me-1"></i> Avaliações dos pacientes</span>
            <span class="small text-muted"><%= media.total %> avaliação(oes)</span>
          </div>
          <div class="card-body">
            <% if (avaliacoes.length) { %>
              <% avaliacoes.forEach(function (avaliacao) { %>
                <div class="d-flex gap-3 py-3 border-bottom">
                  <span class="avatar avatar-sm"><%= avaliacao.paciente.utilizador.nome.charAt(0).toUpperCase() %></span>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between flex-wrap gap-1">
                      <span class="fw-semibold small"><%= avaliacao.paciente.utilizador.nome %></span>
                      <span class="small text-muted"><%= formatarData(avaliacao.criadoEm) %></span>
                    </div>
                    <div class="rating small">
                      <% for (let i = 1; i <= 5; i += 1) { %>
                        <i class="bi <%= i <= avaliacao.estrelas ? 'bi-star-fill' : 'bi-star' %>"></i>
                      <% } %>
                    </div>
                    <% if (avaliacao.comentario) { %>
                      <p class="small text-muted mb-0 mt-1"><%= avaliacao.comentario %></p>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="empty-state py-4">
                <i class="bi bi-star"></i>
                <p class="mb-0 small">Ainda não existem avaliações para este médico.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script nonce="<%= cspNonce %>">
  document.addEventListener('DOMContentLoaded', function () {
    var botoes = document.querySelectorAll('.slot[data-hora]');
    var horaInput = document.getElementById('horaSelecionada');
    var horaTexto = document.getElementById('horaTexto');
    botoes.forEach(function (botao) {
      botao.addEventListener('click', function () {
        if (botao.disabled) return;
        botoes.forEach(function (outro) { outro.classList.remove('active'); });
        botao.classList.add('active');
        if (horaInput) horaInput.value = botao.dataset.hora;
        if (horaTexto) horaTexto.textContent = botao.dataset.hora;
      });
    });
  });
</script>
