<% if (typeof proximasVagas !== 'undefined' && proximasVagas.length) { %>
  <div class="mt-4">
    <div class="small fw-semibold mb-2"><i class="bi bi-lightning-charge me-1 text-success"></i>Próximas vagas disponíveis</div>
    <div class="d-flex flex-wrap gap-2">
      <% proximasVagas.forEach(function (vaga) { %>
        <a class="btn btn-sm btn-outline-ma" href="/medicos/<%= medico.id %>?data=<%= formatarDataInput(vaga.inicio) %>">
          <i class="bi bi-calendar3 me-1"></i><%= formatarData(vaga.inicio) %> · <%= vaga.hora %>
        </a>
      <% }); %>
    </div>
  </div>
<% } %>

<% if (typeof utilizador !== 'undefined' && utilizador && utilizador.perfil === 'PACIENTE') { %>
  <a class="btn btn-outline-ma w-100 mt-3" href="/paciente/lista-espera?medicoId=<%= medico.id %>&data=<%= dataSelecionada %>">
    <i class="bi bi-hourglass-split me-1"></i>Entrar na lista de espera
  </a>
<% } else if (!utilizador) { %>
  <a class="btn btn-outline-ma w-100 mt-3" href="/login?next=<%= encodeURIComponent('/medicos/' + medico.id) %>">
    <i class="bi bi-hourglass-split me-1"></i>Entrar na lista de espera
  </a>
<% } %>
