<%
  const perfilAtual = utilizador.perfil;
  const caminhoAtual = typeof caminho !== 'undefined' ? caminho : '';
  const rotulosPerfil = {
    PACIENTE: 'Paciente',
    MEDICO: 'Médico',
    SECRETARIO: 'Secretaria',
    ADMINISTRADOR: 'Administrador'
  };
  const ativo = function (prefixo) {
    return caminhoAtual === prefixo || caminhoAtual.indexOf(prefixo + '/') === 0;
  };
%>

<div class="sidebar-role">
  <span class="avatar avatar-sm"><%= utilizador.nome.charAt(0).toUpperCase() %></span>
  <div class="min-w-0">
    <div class="role-name text-truncate"><%= utilizador.nome %></div>
    <div class="role-label"><%= rotulosPerfil[perfilAtual] || perfilAtual %></div>
  </div>
</div>

<nav class="sidebar-nav" aria-label="<%= t('nav.navegacaoPrincipal') %>">
  <% if (perfilAtual === 'PACIENTE') { %>
    <div class="sidebar-label">Principal</div>
    <a class="sidebar-link <%= ativo('/paciente/dashboard') ? 'active' : '' %>" href="/paciente/dashboard" <%= ativo('/paciente/dashboard') ? 'aria-current="page"' : '' %>>
      <i class="bi bi-grid-1x2"></i><span>Painel</span>
    </a>
    <a class="sidebar-link <%= ativo('/paciente/consultas') ? 'active' : '' %>" href="/paciente/consultas" <%= ativo('/paciente/consultas') ? 'aria-current="page"' : '' %>>
      <i class="bi bi-calendar2-check"></i><span>As minhas consultas</span>
    </a>
    <a class="sidebar-link <%= ativo('/medicos') ? 'active' : '' %>" href="/medicos" <%= ativo('/medicos') ? 'aria-current="page"' : '' %>>
      <i class="bi bi-calendar2-plus"></i><span>Marcar consulta</span>
    </a>
    <a class="sidebar-link <%= ativo('/paciente/lista-espera') ? 'active' : '' %>" href="/paciente/lista-espera" <%= ativo('/paciente/lista-espera') ? 'aria-current="page"' : '' %>>
      <i class="bi bi-hourglass-split"></i><span>Lista de espera</span>
    </a>
    <a class="sidebar-link <%= ativo('/paciente/documentos') ? 'active' : '' %>" href="/paciente/documentos" <%= ativo('/paciente/documentos') ? 'aria-current="page"' : '' %>>
      <i class="bi bi-folder2-open"></i><span>Documentos</span>
    </a>
    <div class="sidebar-label">Conta</div>
    <a class="sidebar-link <%= ativo('/paciente/perfil') ? 'active' : '' %>" href="/paciente/perfil" <%= ativo('/paciente/perfil') ? 'aria-current="page"' : '' %>>
      <i class="bi bi-person-gear"></i><span>Perfil</span>
    </a>
    <a class="sidebar-link <%= ativo('/conta/seguranca') ? 'active' : '' %>" href="/conta/seguranca" <%= ativo('/conta/seguranca') ? 'aria-current="page"' : '' %>>
      <i class="bi bi-shield-lock"></i><span>Segurança</span>
    </a>
  <% } else if (perfilAtual === 'MEDICO') { %>
    <div class="sidebar-label">Principal</div>
    <a class="sidebar-link <%= ativo('/medico/dashboard') ? 'active' : '' %>" href="/medico/dashboard" <%= ativo('/medico/dashboard') ? 'aria-current="page"' : '' %>>
      <i class="bi bi-grid-1x2"></i><span>Painel</span>
    </a>
    <a class="sidebar-link <%= ativo('/medico/agenda') ? 'active' : '' %>" href="/medico/agenda" <%= ativo('/medico/agenda') ? 'aria-current="page"' : '' %>>
