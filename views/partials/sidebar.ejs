      <i class="bi bi-people"></i><span>Pacientes</span>
    </a>
    <a class="sidebar-link <%= ativo('/secretario/medicos') ? 'active' : '' %>" href="/secretario/medicos" <%= ativo('/secretario/medicos') ? 'aria-current="page"' : '' %>>
