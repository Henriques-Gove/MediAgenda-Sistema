<% if (flash && flash.mensagem) { %>
  <% const icones = { success: 'bi-check-circle-fill', danger: 'bi-exclamation-octagon-fill', warning: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' }; %>
  <div class="container mt-3">
    <div class="alert alert-<%= flash.tipo || 'info' %> alert-dismissible fade show shadow-sm" role="alert">
      <i class="bi <%= icones[flash.tipo] || icones.info %> me-2"></i>
      <span style="white-space: pre-wrap"><%= flash.mensagem %></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  </div>
<% } %>
