<section class="page-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <span class="badge badge-soft-primary mb-2">Área do paciente</span>
        <h1 class="h2 mb-1">Olá, <%= paciente.utilizador.nome.split(' ')[0] %>!</h1>
        <p class="lead mb-0">Aqui tem um resumo das suas consultas e próximos passos.</p>
      </div>
      <a class="btn btn-ma" href="/medicos"><i class="bi bi-calendar2-plus me-1"></i> Marcar nova consulta</a>
    </div>
  </div>
</section>

<section class="pb-5">
  <div class="container">
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex align-items-center gap-3">
            <span class="stat-icon"><i class="bi bi-calendar2-week"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.proximas %></div>
              <div class="stat-label">Próximas</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex align-items-center gap-3">
            <span class="stat-icon"><i class="bi bi-check2-circle"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.realizadas %></div>
              <div class="stat-label">Realizadas</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex align-items-center gap-3">
            <span class="stat-icon"><i class="bi bi-x-circle"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.canceladas %></div>
              <div class="stat-label">Canceladas</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex align-items-center gap-3">
            <span class="stat-icon"><i class="bi bi-clock-history"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.tardias %></div>
              <div class="stat-label">Tardias</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-calendar2-event me-1"></i> Próximas consultas</span>
            <a class="small text-decoration-none" href="/paciente/consultas">Ver todas</a>
          </div>
          <div class="card-body">
            <% if (proximas.length) { %>
              <% proximas.forEach(function (consulta) { %>
                <div class="d-flex flex-column flex-md-row gap-3 py-3 border-bottom">
                  <div class="text-center bg-light rounded-3 px-3 py-2 align-self-start" style="min-width: 5rem">
                    <div class="small text-muted text-uppercase"><%= formatarData(consulta.inicio).slice(3, 5) %>/<%= formatarData(consulta.inicio).slice(6, 10) %></div>
                    <div class="fw-bold fs-5"><%= formatarData(consulta.inicio).slice(0, 2) %></div>
                    <div class="small fw-semibold text-success"><%= formatarHora(consulta.inicio) %></div>
                  </div>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                      <div>
                        <div class="fw-semibold"><%= consulta.medico.utilizador.nome %></div>
                        <div class="small text-muted">
                          <i class="bi bi-tags me-1"></i><%= consulta.especialidade ? consulta.especialidade.nome : 'Consulta geral' %>
                          &middot; <i class="bi bi-geo-alt me-1"></i><%= consulta.medico.localizacao %>
                        </div>
                      </div>
                      <span class="badge badge-soft-<%= coresEstado[consulta.estado] %> align-self-start"><%= rotulosEstado[consulta.estado] %></span>
                    </div>
                    <% if (consulta.motivo) { %>
                      <div class="small text-muted mt-1"><i class="bi bi-chat-left-text me-1"></i><%= consulta.motivo %></div>
                    <% } %>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                      <% if (consulta.estado === 'PENDENTE' && consulta.confirmacaoToken) { %>
                        <a class="btn btn-success btn-sm" href="/confirmar/<%= consulta.confirmacaoToken %>">
                          <i class="bi bi-check2 me-1"></i>Confirmar
                        </a>
                      <% } %>
                      <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelar<%= consulta.id %>">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                      </button>
                    </div>
                  </div>
                </div>

                <div class="modal fade" id="cancelar<%= consulta.id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <form class="modal-content" action="/paciente/consultas/<%= consulta.id %>/cancelar" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <div class="modal-header">
                        <h5 class="modal-title">Cancelar consulta</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                      </div>
                      <div class="modal-body">
                        <p class="small text-muted">
                          Consulta com <strong><%= consulta.medico.utilizador.nome %></strong> em
                          <strong><%= formatarDataHora(consulta.inicio) %></strong>.
                        </p>
                        <label class="form-label" for="motivo<%= consulta.id %>">Motivo do cancelamento</label>
                        <textarea class="form-control" id="motivo<%= consulta.id %>" name="motivo" rows="2" minlength="3" required placeholder="Indique o motivo"></textarea>
                        <div class="alert alert-warning small mt-3 mb-0">
                          <i class="bi bi-exclamation-triangle me-1"></i>
                          Cancelamentos com menos de 24 horas de antecedência são registados como tardios.
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Voltar</button>
                        <button type="submit" class="btn btn-danger">Confirmar cancelamento</button>
                      </div>
                    </form>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="empty-state py-4">
                <i class="bi bi-calendar-check"></i>
                <p class="fw-semibold mb-1">Sem consultas futuras</p>
                <p class="small mb-3">Marque a sua próxima consulta com um dos nossos médicos.</p>
                <a class="btn btn-ma btn-sm" href="/medicos">Encontrar médico</a>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="bi bi-clock-history me-1"></i> Atividade recente</div>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Médico</th>
                  <th>Especialidade</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                <% recentes.forEach(function (consulta) { %>
                  <tr>
                    <td class="small"><%= formatarData(consulta.inicio) %> <span class="text-muted"><%= formatarHora(consulta.inicio) %></span></td>
                    <td class="small"><%= consulta.medico.utilizador.nome %></td>
                    <td class="small"><%= consulta.especialidade ? consulta.especialidade.nome : '-' %></td>
                    <td><span class="badge badge-soft-<%= coresEstado[consulta.estado] %>"><%= rotulosEstado[consulta.estado] %></span></td>
                  </tr>
                <% }); %>
                <% if (!recentes.length) { %>
                  <tr><td colspan="4" class="text-center text-muted small py-4">Ainda sem atividade.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card mb-4">
          <div class="card-header"><i class="bi bi-lightning-charge me-1"></i> Ações rápidas</div>
          <div class="list-group list-group-flush">
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/medicos">
              <i class="bi bi-search text-success"></i> Pesquisar médicos
            </a>
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/paciente/consultas?estado=PENDENTE">
              <i class="bi bi-hourglass-split text-warning"></i> Consultas por confirmar
            </a>
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/paciente/consultas?estado=REALIZADA">
              <i class="bi bi-star text-success"></i> Avaliar consultas
            </a>
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/paciente/perfil">
              <i class="bi bi-person-gear text-secondary"></i> Atualizar perfil
            </a>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-header"><i class="bi bi-tags me-1"></i> Especialidades</div>
          <div class="card-body">
            <div class="d-flex flex-wrap gap-1">
              <% especialidades.slice(0, 10).forEach(function (especialidade) { %>
                <a class="specialty-pill text-decoration-none" href="/medicos?especialidade=<%= especialidade.id %>"><%= especialidade.nome %></a>
              <% }); %>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-2">
              <i class="bi bi-bell text-success"></i>
              <span class="fw-semibold">Lembretes automáticos</span>
            </div>
            <p class="small text-muted mb-0">
              Recebera lembretes 24 horas e 1 hora antes de cada consulta, no canal que escolheu no seu perfil.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
