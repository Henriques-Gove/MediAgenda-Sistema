<section class="dashboard-page dashboard-paciente">
  <div class="dashboard-bg"></div>
  <div class="dashboard-scene" aria-hidden="true">
    <i class="bi bi-heart-pulse"></i>
    <i class="bi bi-calendar2-check"></i>
    <i class="bi bi-capsule"></i>
    <i class="bi bi-person-heart"></i>
  </div>

  <div class="dashboard-shell">
    <header class="dashboard-header">
      <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
          <div>
            <span class="dashboard-eyebrow"><i class="bi bi-heart-pulse"></i> Área do paciente</span>
            <h1>Olá, <%= paciente.utilizador.nome.split(' ')[0] %></h1>
            <p class="dashboard-lead">Marque, confirme e acompanhe as suas consultas.</p>
          </div>
          <a class="btn btn-ma" href="/medicos"><i class="bi bi-calendar2-plus me-1"></i> Marcar consulta</a>
        </div>
      </div>
    </header>

    <div class="container pb-5">
      <div class="row g-2 g-md-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-proximas"><i class="bi bi-calendar2-week"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.proximas %></div>
              <div class="stat-label">Próximas</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-realizadas"><i class="bi bi-check2-circle"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.realizadas %></div>
              <div class="stat-label">Realizadas</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-canceladas"><i class="bi bi-x-circle"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.canceladas %></div>
              <div class="stat-label">Canceladas</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-tardias"><i class="bi bi-clock-history"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.tardias %></div>
              <div class="stat-label">Tardias</div>
            </div>
          </div>
        </div>
      </div>

      <h2 class="dashboard-section-title">O que quer fazer?</h2>
      <div class="tile-grid mb-4">
        <a class="tile" href="/medicos">
          <span class="tile-icon"><i class="bi bi-calendar2-plus"></i></span>
          <h3 class="tile-title">Marcar consulta</h3>
          <p class="tile-meta">Escolher médico e horário</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/paciente/consultas">
          <span class="tile-icon"><i class="bi bi-calendar2-event"></i></span>
          <h3 class="tile-title">Minhas consultas</h3>
          <p class="tile-meta"><%= proximas.length %> por confirmar</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/paciente/consultas?estado=REALIZADA">
          <span class="tile-icon"><i class="bi bi-star"></i></span>
          <h3 class="tile-title">Avaliar consulta</h3>
          <p class="tile-meta">Deixar a sua opinião</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/paciente/lista-espera">
          <span class="tile-icon"><i class="bi bi-hourglass-split"></i></span>
          <h3 class="tile-title">Lista de espera</h3>
          <p class="tile-meta">Ser avisado de vagas</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
      </div>

      <div class="row g-3 g-lg-4">
        <div class="col-lg-8">
          <div class="dashboard-card">
            <div class="card-header">
              <span><i class="bi bi-calendar2-event me-1"></i> Próximas consultas</span>
              <a class="small text-decoration-none" href="/paciente/consultas">Ver todas</a>
            </div>
            <div class="card-body p-0">
              <% if (proximas.length) { %>
                <% proximas.forEach(function (consulta) { %>
                  <div class="p-3 border-bottom">
                    <div class="d-flex gap-3">
                      <div class="text-center bg-light rounded-3 px-2 py-1 align-self-start" style="min-width: 4.5rem">
                        <div class="small text-muted"><%= formatarData(consulta.inicio).slice(0, 5) %></div>
                        <div class="small fw-semibold text-success"><%= formatarHora(consulta.inicio) %></div>
                      </div>
                      <div class="flex-grow-1">
                        <div class="d-flex justify-content-between flex-wrap gap-1">
                          <div class="fw-semibold small"><%= consulta.medico.utilizador.nome %></div>
                          <span class="badge badge-soft-<%= coresEstado[consulta.estado] %>"><%= rotulosEstado[consulta.estado] %></span>
                        </div>
                        <div class="small text-muted">
                          <%= consulta.especialidade ? consulta.especialidade.nome : 'Consulta geral' %>
                          &middot; <%= consulta.medico.localizacao %>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                          <% if (consulta.estado === 'PENDENTE' && consulta.confirmacaoToken) { %>
                            <a class="btn btn-success btn-sm" href="/confirmar/<%= consulta.confirmacaoToken %>">
                              <i class="bi bi-check2 me-1"></i>Confirmar
                            </a>
                          <% } %>
                          <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelar<%= consulta.id %>">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="modal fade" id="cancelar<%= consulta.id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <form class="modal-content" action="/paciente/consultas/<%= consulta.id %>/cancelar" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <div class="modal-header">
                          <h5 class="modal-title">Cancelar consulta</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body">
                          <p class="small text-muted">
                            <%= consulta.medico.utilizador.nome %> &middot; <%= formatarDataHora(consulta.inicio) %>
                          </p>
                          <label class="form-label" for="motivo<%= consulta.id %>">Motivo</label>
                          <textarea class="form-control" id="motivo<%= consulta.id %>" name="motivo" rows="2" minlength="3" required placeholder="Indique o motivo"></textarea>
                          <p class="form-text mb-0">Cancelamentos com menos de 24 horas ficam registados como tardios.</p>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Voltar</button>
                          <button type="submit" class="btn btn-danger">Cancelar consulta</button>
                        </div>
                      </form>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="dashboard-empty">
                  <i class="bi bi-calendar-check"></i>
                  <p>Não tem consultas marcadas.</p>
                  <a class="btn btn-ma btn-sm" href="/medicos">Encontrar médico</a>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="dashboard-card">
            <div class="card-header"><span><i class="bi bi-bell me-1"></i> Lembretes</span></div>
            <div class="card-body">
              <p class="small text-muted mb-2">Recebe um aviso 24 horas e 1 hora antes de cada consulta.</p>
              <a class="small text-decoration-none" href="/paciente/perfil">Alterar forma de contacto</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
