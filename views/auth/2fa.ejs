<section class="auth-page">
  <div class="auth-frame auth-frame-sm">
    <%- include('../partials/auth-brand', {
      authBadge: 'Segurança da conta',
      authTitulo: 'Um passo extra para proteger os seus dados.',
      authTexto: 'Confirme a sua identidade com o código gerado na aplicação de autenticação.'
    }) %>

    <div class="auth-panel">
      <a class="auth-mobile-brand d-lg-none" href="/inicio">
        <span class="brand-mark"><i class="bi bi-heart-pulse-fill"></i></span>
        <span>MediAgenda</span>
      </a>

      <div class="auth-panel-header">
        <h2>Verificação em dois passos</h2>
        <p>Abra a aplicação de autenticação e introduza o código de seis dígitos.</p>
      </div>

      <form action="/login/2fa" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="mb-3">
          <label class="form-label" for="token">Código de verificação</label>
          <input
            class="form-control form-control-lg text-center mono"
            id="token"
            name="token"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{6}"
            maxlength="6"
            placeholder="000000"
            required
            autofocus
          />
          <div class="form-text">O código muda a cada 30 segundos.</div>
        </div>

        <button class="btn btn-ma w-100" type="submit">
          <i class="bi bi-shield-check me-1"></i> Confirmar e entrar
        </button>
      </form>

      <p class="auth-switch mt-3">
        <a href="/login"><i class="bi bi-arrow-left me-1"></i>Voltar ao início de sessão</a>
      </p>
    </div>
  </div>
</section>
