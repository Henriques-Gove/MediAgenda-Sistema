<section class="auth-page">
  <div class="auth-bg-video">
    <!-- Coloque aqui o vídeo de fundo do login (ex.: clínica, médicos a trabalhar): -->
    <!-- <video loop muted playsinline autoplay poster="/img/auth-login-poster.jpg">
      <source src="/videos/auth-login.mp4" type="video/mp4" />
    </video> -->
    <div class="auth-bg-gradient"></div>
    <span class="auth-particle" style="width: 4rem; height: 4rem; top: 10%; left: 8%; animation-delay: 0s;"></span>
    <span class="auth-particle" style="width: 2.5rem; height: 2.5rem; top: 42%; left: 88%; animation-delay: -3s;"></span>
    <span class="auth-particle" style="width: 3.5rem; height: 3.5rem; top: 78%; left: 12%; animation-delay: -6s;"></span>
    <span class="auth-particle" style="width: 2rem; height: 2rem; top: 22%; left: 55%; animation-delay: -9s;"></span>
  </div>

  <div class="auth-frame">
    <%- include('../partials/auth-brand', {
      authBadge: 'Agendamento online 24/7',
      authTitulo: 'A sua saúde, agendada em minutos.',
      authDestaque: 'O nosso maior valor é a vida.'
    }) %>

    <div class="auth-panel">
      <a class="auth-mobile-brand d-lg-none" href="/inicio">
        <span class="brand-mark"><i class="bi bi-heart-pulse-fill"></i></span>
        <span>MediAgenda</span>
      </a>

      <div class="auth-panel-header">
        <h2>Bem-vindo de volta</h2>
        <p>Inicie sessão para gerir as suas consultas.</p>
      </div>

      <form action="/login" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="next" value="<%= next %>" />

        <div class="mb-2">
          <label class="form-label" for="email">E-mail</label>
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
            <input
              class="form-control <%= erros.email ? 'is-invalid' : '' %>"
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="nome@exemplo.com"
              value="<%= valores.email || '' %>"
              required
              autofocus
            />
          </div>
          <% if (erros.email) { %><div class="invalid-feedback d-block"><%= erros.email %></div><% } %>
        </div>

        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <label class="form-label" for="password">Palavra-passe</label>
            <a class="small text-decoration-none" href="/recuperar">Esqueceu-se?</a>
          </div>
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-key"></i></span>
            <input
              class="form-control"
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              placeholder="A sua palavra-passe"
              required
            />
            <button class="btn btn-outline-secondary" type="button" data-toggle-password="password" aria-label="Mostrar palavra-passe">
              <i class="bi bi-eye"></i>
            </button>
          </div>
        </div>

        <button class="btn btn-ma w-100" type="submit">
          <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
        </button>
      </form>

      <p class="auth-switch">
        Ainda não tem conta? <a href="/registo">Criar conta</a>
      </p>
      <a class="auth-back" href="/inicio"><i class="bi bi-arrow-left"></i>Voltar ao site</a>
    </div>
  </div>
  </div>
</section>
