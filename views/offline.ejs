<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <div class="card">
          <div class="card-body p-4 p-md-5 text-center">
            <span class="feature-icon mb-3"><i class="bi bi-wifi-off"></i></span>
            <h1 class="h3 fw-bold mb-2"><%= t('pwa.offlineTitulo') %></h1>
            <p class="text-muted mb-4"><%= t('pwa.offlineTexto') %></p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
              <button class="btn btn-ma" type="button" data-reload>
                <i class="bi bi-arrow-clockwise me-1"></i><%= t('pwa.tentarNovamente') %>
              </button>
              <a class="btn btn-outline-ma" href="/"><i class="bi bi-house me-1"></i><%= t('nav.inicio') %></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
