<section class="dashboard-page dashboard-medico">
  <div class="dashboard-bg"></div>

  <div class="dashboard-shell">
    <header class="dashboard-header">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <span class="badge badge-soft-primary mb-2">Área do Médico</span>
          <h1 class="h2 mb-1">Bom dia, <%= medico.utilizador.nome.replace('Dr. ', '').replace('Dra. ', '').split(' ')[0] %>!</h1>
          <p class="lead mb-0"><%= formatarDiaSemana(hoje) %></p>
        </div>
        <div class="d-flex gap-2">
          <a class="btn btn-outline-ma" href="/medico/agenda"><i class="bi bi-calendar3 me-1"></i> Agenda</a>
          <a class="btn btn-ma" href="/medico/disponibilidade"><i class="bi bi-clock me-1"></i> Disponibilidade</a>
        </div>
      </div>
    </header>

    <div class="dashboard-body container pb-5">
      <!-- Estatísticas rápidas -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <span class="stat-icon stat-icon-hoje"><i class="bi bi-calendar-day"></i></span>
              <div>
                <div class="stat-value"><%= estatisticas.hoje %></div>
                <div class="stat-label">Hoje</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <span class="stat-icon stat-icon-pendentes"><i class="bi bi-hourglass-split"></i></span>
              <div>
                <div class="stat-value"><%= estatisticas.pendentes %></div>
                <div class="stat-label">Pendentes</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <span class="stat-icon stat-icon-realizadas"><i class="bi bi-check2-circle"></i></span>
              <div>
                <div class="stat-value"><%= estatisticas.realizadas %></div>
                <div class="stat-label">Realizadas</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <span class="stat-icon stat-icon-canceladas"><i class="bi bi-x-circle"></i></span>
              <div>
                <div class="stat-value"><%= estatisticas.canceladas %></div>
                <div class="stat-label">Canceladas</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tiles de ação principal -->
      <div class="dashboard-tiles row g-4 mb-4">
        <div class="col-12 col-lg-6 col-xl-4">
          <div class="tile tile-agenda" data-tile="agenda">
            <div class="tile-front">
              <div class="tile-icon"><i class="bi bi-calendar3"></i></div>
              <h3 class="tile-title">Agenda diária</h3>
              <p class="tile-subtitle">Consultas confirmadas para hoje</p>
              <span class="tile-badge"><%= agendaHoje.length %> hoje</span>
            </div>
            <div class="tile-back">
              <i class="bi bi-arrow-right-circle"></i>
              <span>Ver agenda completa</span>
            </div>
            <a class="tile-link" href="/medico/agenda"></a>
          </div>
        </div>
        <div class="col-12 col-lg-6 col-xl-4">
          <div class="tile tile-disponibilidade" data-tile="disponibilidade">
            <div class="tile-front">
              <div class="tile-icon"><i class="bi bi-clock"></i></div>
              <h3 class="tile-title">Disponibilidade</h3>
              <p class="tile-subtitle">Defina os seus horários de atendimento</p>
              <span class="tile-badge">Gestão de agenda</span>
            </div>
            <div class="tile-back">
              <i class="bi bi-arrow-right-circle"></i>
              <span>Configurar horários</span>
            </div>
            <a class="tile-link" href="/medico/disponibilidade"></a>
          </div>
        </div>
        <div class="col-12 col-lg-4 col-xl-4">
          <div class="tile tile-documentos" data-tile="documentos">
            <div class="tile-front">
              <div class="tile-icon"><i class="bi bi-file-medical"></i></div>
              <h3 class="tile-title">Documentos clínicos</h3>
              <p class="tile-subtitle">Escreva e anexe documentos de consulta</p>
              <span class="tile-badge">Prontuário</span>
            </div>
            <div class="tile-back">
              <i class="bi bi-arrow-right-circle"></i>
              <span>Gerir documentos</span>
            </div>
            <a class="tile-link" href="/medico/documentos"></a>
          </div>
        </div>
      </div>

      <!-- Agenda de hoje -->
      <div class="row g-4">
        <div class="col-lg-8">
          <div class="card dashboard-card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span><i class="bi bi-calendar-day me-1"></i> Agenda de hoje</span>
              <span class="small text-muted"><%= agendaHoje.length %> consulta(s)</span>
            </div>
            <div class="card-body">
              <% if (agendaHoje.length) { %>
                <div class="timeline">
                  <% agendaHoje.forEach(function (consulta) { %>
                    <div class="timeline-item">
                      <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                          <div class="fw-semibold">
                            <span class="text-success"><%= formatarHora(consulta.inicio) %></span>
                            <%= consulta.paciente.utilizador.nome %>
                          </div>
                          <div class="small text-muted">
                            <%= consulta.especialidade ? consulta.especialidade.nome : 'Consulta geral' %>
                            <% if (consulta.motivo) { %> &middot; <%= consulta.motivo %><% } %>
                          </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                          <span class="badge badge-soft-<%= coresEstado[consulta.estado] %>"><%= rotulosEstado[consulta.estado] %></span>
                          <% if (consulta.estado === 'CONFIRMADA') { %>
                            <form action="/medico/consultas/<%= consulta.id %>/realizar" method="post" style="display:inline">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check2 me-1"></i> Realizar</button>
                            </form>
                          <% } else if (consulta.estado === 'REALIZADA') { %>
                            <a class="btn btn-outline-primary btn-sm" href="/medico/documentos/novo?consulta=<%= consulta.id %>"><i class="bi bi-file-earmark-plus me-1"></i> Documento</a>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="empty-state py-5 text-center">
                  <i class="bi bi-calendar-event display-4 text-muted mb-3"></i>
                  <p class="fw-semibold mb-1">Sem consultas hoje</p>
                  <p class="small mb-4">Aproveite para definir a sua disponibilidade nos próximos dias.</p>
                  <a class="btn btn-ma" href="/medico/disponibilidade">Definir disponibilidade</a>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="card dashboard-card mb-4">
            <div class="card-header"><i class="bi bi-lightning-charge me-1"></i> Ações rápidas</div>
            <div class="list-group list-group-flush">
              <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/medico/agenda">
                <i class="bi bi-calendar-week text-success"></i> Agenda semanal
              </a>
              <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/medico/bloqueios">
                <i class="bi bi-slash-circle text-warning"></i> Bloqueios e férias
              </a>
              <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/medico/perfil">
                <i class="bi bi-person-gear text-secondary"></i> Meu perfil
              </a>
              <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/medico/avaliacoes">
                <i class="bi bi-star text-info"></i> Minhas avaliações
              </a>
            </div>
          </div>

          <div class="card dashboard-card">
            <div class="card-header"><i class="bi bi-award me-1"></i> Satisfação</div>
            <div class="card-body">
              <div class="d-flex align-items-center gap-2 mb-3">
                <span class="display-4 fw-bold text-warning"><%= (medico.avaliacaoMedia ?? 0).toFixed(1) %></span>
                <span class="text-muted small">de 5,0</span>
              </div>
              <div class="progress" style="height: 0.6rem">
                <div class="progress-bar bg-warning" role="progressbar" style="width: <%= Math.round((medico.avaliacaoMedia ?? 0) / 5 * 100) %>%"></div>
              </div>
              <p class="small text-muted mt-2 mb-0"><%= medico.totalAvaliacoes || 0 %> avaliação(ões)</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dashboard-medico .dashboard-bg {
    background:
      radial-gradient(circle at 25% 35%, rgba(59, 130, 246, 0.22), transparent 45%),
      radial-gradient(circle at 85% 80%, rgba(14, 165, 233, 0.15), transparent 50%),
      linear-gradient(135deg, #eff6ff 0%, #dbeafe 60%, #bfdbfe 100%);
  }
  .dashboard-medico .stat-icon-hoje { background: #dbeafe; color: #2563eb; }
  .dashboard-medico .stat-icon-pendentes { background: #fef3c7; color: #d97706; }
  .dashboard-medico .stat-icon-realizadas { background: #d1fae5; color: #059669; }
  .dashboard-medico .stat-icon-canceladas { background: #fee2e2; color: #dc2626; }
  .dashboard-medico .tile-icon { color: #2563eb; background: #dbeafe; }
  .dashboard-medico .tile-back { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); }
  .dashboard-medico .badge-soft-success { background: #d1fae5; color: #065f46; }
</style>
