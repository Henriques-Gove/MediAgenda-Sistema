<section class="dashboard-page dashboard-medico">
  <div class="dashboard-bg"></div>

  <div class="dashboard-shell">
    <header class="dashboard-header">
      <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
          <div>
            <span class="dashboard-eyebrow"><i class="bi bi-clipboard2-pulse"></i> Área do médico</span>
            <h1>Bom dia, <%= medico.utilizador.nome.replace('Dr. ', '').replace('Dra. ', '').split(' ')[0] %></h1>
            <p class="dashboard-lead"><%= formatarDiaSemana(hoje) %></p>
          </div>
          <div class="d-flex flex-column flex-sm-row gap-2">
            <a class="btn btn-outline-ma" href="/medico/agenda"><i class="bi bi-calendar3 me-1"></i> Agenda</a>
            <a class="btn btn-ma" href="/medico/disponibilidade"><i class="bi bi-clock me-1"></i> Disponibilidade</a>
          </div>
        </div>
      </div>
    </header>

    <div class="container pb-5">
      <div class="row g-2 g-md-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-hoje"><i class="bi bi-calendar-day"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.hoje %></div>
              <div class="stat-label">Hoje</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-pendentes"><i class="bi bi-hourglass-split"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.pendentes %></div>
              <div class="stat-label">Pendentes</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-realizadas"><i class="bi bi-check2-circle"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.realizadas %></div>
              <div class="stat-label">Realizadas</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-canceladas"><i class="bi bi-x-circle"></i></span>
            <div>
              <div class="stat-value"><%= estatisticas.canceladas %></div>
              <div class="stat-label">Canceladas</div>
            </div>
          </div>
        </div>
      </div>

      <h2 class="dashboard-section-title">Atalhos</h2>
      <div class="tile-grid mb-4">
        <a class="tile" href="/medico/agenda">
          <span class="tile-icon"><i class="bi bi-calendar3"></i></span>
          <h3 class="tile-title">Agenda</h3>
          <p class="tile-meta"><%= agendaHoje.length %> consulta(s) hoje</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/medico/disponibilidade">
          <span class="tile-icon"><i class="bi bi-clock"></i></span>
          <h3 class="tile-title">Disponibilidade</h3>
          <p class="tile-meta">Definir horários</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/medico/documentos">
          <span class="tile-icon"><i class="bi bi-file-medical"></i></span>
          <h3 class="tile-title">Documentos</h3>
          <p class="tile-meta">Receitas e notas</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/medico/bloqueios">
          <span class="tile-icon"><i class="bi bi-slash-circle"></i></span>
          <h3 class="tile-title">Bloqueios</h3>
          <p class="tile-meta">Férias e ausências</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
      </div>

      <div class="row g-3 g-lg-4">
        <div class="col-lg-8">
          <div class="dashboard-card">
            <div class="card-header">
              <span><i class="bi bi-calendar-day me-1"></i> Hoje</span>
              <a class="small text-decoration-none" href="/medico/agenda">Ver agenda</a>
            </div>
            <div class="card-body p-0">
              <% if (agendaHoje.length) { %>
                <% agendaHoje.forEach(function (consulta) { %>
                  <div class="p-3 border-bottom">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                      <div>
                        <div class="fw-semibold small">
                          <span class="text-success"><%= formatarHora(consulta.inicio) %></span>
                          <%= consulta.paciente.utilizador.nome %>
                        </div>
                        <div class="small text-muted">
                          <%= consulta.especialidade ? consulta.especialidade.nome : 'Consulta geral' %>
                          <% if (consulta.motivo) { %> &middot; <%= consulta.motivo %><% } %>
                        </div>
                      </div>
                      <div class="d-flex align-items-center gap-2">
                        <span class="badge badge-soft-<%= coresEstado[consulta.estado] %>"><%= rotulosEstado[consulta.estado] %></span>
                        <% if (consulta.estado === 'CONFIRMADA') { %>
                          <form action="/medico/consultas/<%= consulta.id %>/realizar" method="post">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check2 me-1"></i>Realizar</button>
                          </form>
                        <% } else if (consulta.estado === 'REALIZADA') { %>
                          <a class="btn btn-outline-primary btn-sm" href="/medico/documentos/novo?consulta=<%= consulta.id %>"><i class="bi bi-file-earmark-plus me-1"></i>Documento</a>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="dashboard-empty">
                  <i class="bi bi-calendar-event"></i>
                  <p>Sem consultas hoje.</p>
                  <a class="btn btn-ma btn-sm" href="/medico/disponibilidade">Definir disponibilidade</a>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="dashboard-card">
            <div class="card-header"><span><i class="bi bi-award me-1"></i> Satisfação</span></div>
            <div class="card-body">
              <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="fs-3 fw-bold text-warning"><%= (medico.avaliacaoMedia ?? 0).toFixed(1) %></span>
                <span class="text-muted small">de 5,0</span>
              </div>
              <div class="progress mb-2" style="height: 0.5rem">
                <div class="progress-bar bg-warning" role="progressbar" style="width: <%= Math.round((medico.avaliacaoMedia ?? 0) / 5 * 100) %>%"></div>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                <span class="small text-muted"><%= medico.totalAvaliacoes || 0 %> avaliação(ões)</span>
                <a class="small text-decoration-none" href="/medico/avaliacoes">Ver</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
