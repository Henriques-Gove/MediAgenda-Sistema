<section class="page-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h1 class="h2 mb-1">Disponibilidade semanal</h1>
        <p class="lead mb-0">Defina as janelas em que aceita marcações. Pode ter duas janelas por dia (ex.: manhã e tarde).</p>
      </div>
      <a class="btn btn-outline-ma" href="/medico/agenda"><i class="bi bi-calendar3 me-1"></i> Ver agenda</a>
    </div>
  </div>
</section>

<section class="pb-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-9">
        <div class="card">
          <div class="card-header"><i class="bi bi-clock-history me-1"></i> Janelas de atendimento</div>
          <div class="card-body p-4">
            <form action="/medico/disponibilidade" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <% for (let dia = 0; dia <= 6; dia += 1) { %>
                <% const janelas = medico.disponibilidades.filter(function (item) { return item.diaSemana === dia; }); %>
                <div class="day-row">
                  <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">
                    <div class="fw-semibold" style="min-width: 8.5rem"><%= diasSemana[dia] %></div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                      <input class="form-control form-control-sm" style="width: 7rem" type="time" name="inicio_<%= dia %>" value="<%= janelas[0] ? janelas[0].horaInicio : '' %>" aria-label="Inicio <%= diasSemana[dia] %>" />
                      <span class="text-muted small">até</span>
                      <input class="form-control form-control-sm" style="width: 7rem" type="time" name="fim_<%= dia %>" value="<%= janelas[0] ? janelas[0].horaFim : '' %>" aria-label="Fim <%= diasSemana[dia] %>" />
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                      <span class="text-muted small ms-md-2">2. janela</span>
                      <input class="form-control form-control-sm" style="width: 7rem" type="time" name="inicio2_<%= dia %>" value="<%= janelas[1] ? janelas[1].horaInicio : '' %>" aria-label="Segundo inicio <%= diasSemana[dia] %>" />
                      <span class="text-muted small">até</span>
                      <input class="form-control form-control-sm" style="width: 7rem" type="time" name="fim2_<%= dia %>" value="<%= janelas[1] ? janelas[1].horaFim : '' %>" aria-label="Segundo fim <%= diasSemana[dia] %>" />
                    </div>
                  </div>
                </div>
              <% } %>

              <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-4">
                <p class="small text-muted mb-0">
                  <i class="bi bi-info-circle me-1"></i>
                  Deixe os campos vazios nos dias em que não atende. As janelas devem estar dentro do horário da clínica.
                </p>
                <button class="btn btn-ma" type="submit"><i class="bi bi-check2-circle me-1"></i> Guardar disponibilidade</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="col-lg-3">
        <div class="card mb-4">
          <div class="card-header"><i class="bi bi-info-circle me-1"></i> Regras aplicadas</div>
          <div class="card-body small text-muted">
            <div class="d-flex gap-2 mb-2"><i class="bi bi-clock text-success"></i><span>As vagas respeitam o horário de funcionamento da clínica.</span></div>
            <div class="d-flex gap-2 mb-2"><i class="bi bi-hourglass text-success"></i><span>As marcações exigem uma antecedência mínima de 1 hora.</span></div>
            <div class="d-flex gap-2 mb-2"><i class="bi bi-person-check text-success"></i><span>A duração da consulta e definida no perfil (60 a 120 minutos).</span></div>
            <div class="d-flex gap-2"><i class="bi bi-calendar-x text-success"></i><span>Bloqueios e férias removem automaticamente as vagas.</span></div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="bi bi-person-vcard me-1"></i> Resumo</div>
          <div class="card-body small">
            <div class="d-flex justify-content-between py-1"><span class="text-muted">Duração</span><span class="fw-semibold"><%= medico.duracaoConsultaMinutos %> min</span></div>
            <div class="d-flex justify-content-between py-1"><span class="text-muted">Max./dia</span><span class="fw-semibold"><%= medico.maxConsultasDia %></span></div>
            <div class="d-flex justify-content-between py-1"><span class="text-muted">Dias ativos</span><span class="fw-semibold"><%= new Set(medico.disponibilidades.map(function (d) { return d.diaSemana; })).size %></span></div>
            <a class="btn btn-outline-ma btn-sm w-100 mt-2" href="/medico/perfil">Alterar duração</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
