<section class="page-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h1 class="h2 mb-1">Histórico de consultas</h1>
        <p class="lead mb-0">Todas as consultas associadas ao seu perfil profissional.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-ma" href="/medico/agenda"><i class="bi bi-calendar3 me-1"></i> Agenda</a>
        <div class="btn-group">
          <a class="btn btn-outline-secondary" href="/medico/consultas/exportar.csv?estado=<%= filtros.estado %>" title="Exportar CSV"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
          <a class="btn btn-outline-secondary" href="/medico/consultas/exportar.pdf?estado=<%= filtros.estado %>" title="Exportar PDF"><i class="bi bi-filetype-pdf me-1"></i>PDF</a>
          <a class="btn btn-outline-secondary" href="/medico/consultas/exportar.ics" title="Adicionar ao calendário"><i class="bi bi-calendar-plus me-1"></i>.ics</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="pb-5">
  <div class="container">
    <div class="card mb-4">
      <div class="card-body p-3">
        <form action="/medico/consultas" method="get" class="row g-2 align-items-end">
          <div class="col-8 col-md-4">
            <label class="form-label" for="estado">Estado</label>
            <select class="form-select" id="estado" name="estado" data-auto-submit>
              <option value="">Todos</option>
              <% ['PENDENTE', 'CONFIRMADA', 'REALIZADA', 'CANCELADA'].forEach(function (estado) { %>
                <option value="<%= estado %>" <%= filtros.estado === estado ? 'selected' : '' %>><%= rotulosEstado[estado] %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-4 col-md-2">
            <a class="btn btn-outline-secondary w-100" href="/medico/consultas" aria-label="Limpar filtros" title="Limpar filtros"><i class="bi bi-arrow-counterclockwise"></i></a>
          </div>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-1"></i> Consultas</span>
        <span class="small text-muted"><%= consultas.length %> registo(s)</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Data</th>
              <th>Paciente</th>
              <th>Especialidade</th>
              <th>Estado</th>
              <th>Avaliação</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% consultas.forEach(function (consulta) { %>
              <tr>
                <td class="small">
                  <div class="fw-semibold"><%= formatarData(consulta.inicio) %></div>
                  <div class="text-muted"><%= formatarHora(consulta.inicio) %> - <%= formatarHora(consulta.fim) %></div>
                </td>
                <td class="small">
                  <div class="fw-semibold"><%= consulta.paciente.utilizador.nome %></div>
                  <div class="text-muted"><%= consulta.paciente.telefone %></div>
                </td>
                <td class="small"><%= consulta.especialidade ? consulta.especialidade.nome : 'Consulta geral' %></td>
                <td><span class="badge badge-soft-<%= coresEstado[consulta.estado] %>"><%= rotulosEstado[consulta.estado] %></span></td>
                <td class="small">
                  <% if (consulta.avaliacao) { %>
                    <span class="rating">
                      <% for (let i = 1; i <= 5; i += 1) { %><i class="bi <%= i <= consulta.avaliacao.estrelas ? 'bi-star-fill' : 'bi-star' %>"></i><% } %>
                    </span>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-1">
                    <a class="btn btn-sm btn-outline-secondary" href="/medico/pacientes/<%= consulta.pacienteId %>/historico" title="Histórico do paciente"><i class="bi bi-clock-history"></i></a>
                    <% if (consulta.estado === 'CONFIRMADA') { %>
                      <form action="/medico/consultas/<%= consulta.id %>/realizar" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button class="btn btn-sm btn-ma" type="submit" title="Marcar como realizada"><i class="bi bi-check2"></i></button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
            <% if (!consultas.length) { %>
              <tr><td colspan="6" class="text-center text-muted py-4">Nenhuma consulta encontrada.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination') %>
    </div>
  </div>
</section>
