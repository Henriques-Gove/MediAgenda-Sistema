<section class="page-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h1 class="h2 mb-1">Lista de espera</h1>
        <p class="lead mb-0">Pacientes que aguardam uma vaga com o seu perfil.</p>
      </div>
      <a class="btn btn-outline-ma" href="/medico/agenda"><i class="bi bi-calendar3 me-1"></i> Ver agenda</a>
    </div>
  </div>
</section>

<section class="pb-5">
  <div class="container">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-hourglass-split me-1"></i> Pedidos ativos</span>
        <span class="small text-muted"><%= pedidos.length %> pedido(s)</span>
      </div>
      <div class="card-body">
        <% if (pedidos.length) { %>
          <div class="row g-3">
            <% pedidos.forEach(function (pedido) { %>
              <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100">
                  <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                      <div class="fw-semibold"><%= pedido.paciente.utilizador.nome %></div>
                      <div class="small text-muted"><%= pedido.paciente.telefone %></div>
                    </div>
                    <span class="badge badge-soft-success">Ativo</span>
                  </div>
                  <div class="small text-muted mt-2">
                    <div><i class="bi bi-tag me-1"></i><%= pedido.especialidade ? pedido.especialidade.nome : 'Qualquer especialidade' %></div>
                    <% if (pedido.dataPreferida) { %><div><i class="bi bi-calendar3 me-1"></i>Prefere <%= formatarData(pedido.dataPreferida) %></div><% } %>
                    <% if (pedido.periodo) { %><div><i class="bi bi-clock me-1"></i><%= pedido.periodo === 'MANHA' ? 'Manhã' : pedido.periodo === 'TARDE' ? 'Tarde' : 'Dia inteiro' %></div><% } %>
                    <div><i class="bi bi-inbox me-1"></i>Pedido em <%= formatarData(pedido.criadoEm) %></div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-state py-5">
            <i class="bi bi-hourglass"></i>
            <p class="fw-semibold mb-1">Sem pedidos ativos</p>
            <p class="small mb-0">Quando um paciente entrar na lista de espera para si, aparece aqui.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
