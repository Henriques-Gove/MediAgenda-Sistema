<section class="dashboard-page dashboard-secretario">
  <div class="dashboard-bg"></div>
  <div class="dashboard-scene" aria-hidden="true">
    <i class="bi bi-headset"></i>
    <i class="bi bi-person-plus"></i>
    <i class="bi bi-calendar2-plus"></i>
    <i class="bi bi-chat-dots"></i>
  </div>

  <div class="dashboard-shell">
    <header class="dashboard-header">
      <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
          <div>
            <span class="dashboard-eyebrow"><i class="bi bi-headset"></i> Área da secretaria</span>
            <h1>Atendimento</h1>
            <p class="dashboard-lead"><%= formatarDiaSemana(hoje) %></p>
          </div>
          <div class="d-flex flex-column flex-sm-row gap-2">
            <a class="btn btn-outline-ma" href="/secretario/pacientes"><i class="bi bi-person-plus me-1"></i> Paciente</a>
            <a class="btn btn-ma" href="/secretario/agendas"><i class="bi bi-calendar2-plus me-1"></i> Marcar consulta</a>
          </div>
        </div>
      </div>
    </header>

    <div class="container pb-5">
      <div class="row g-2 g-md-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-hoje"><i class="bi bi-calendar-day"></i></span>
            <div>
              <div class="stat-value"><%= consultasHoje.length %></div>
              <div class="stat-label">Hoje</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-pacientes"><i class="bi bi-people"></i></span>
            <div>
              <div class="stat-value"><%= pacientes.length %></div>
              <div class="stat-label">Pacientes</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-medicos"><i class="bi bi-person-badge"></i></span>
            <div>
              <div class="stat-value"><%= medicos.length %></div>
              <div class="stat-label">Médicos</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-especialidades"><i class="bi bi-tags"></i></span>
            <div>
              <div class="stat-value"><%= especialidades.length %></div>
              <div class="stat-label">Especialidades</div>
            </div>
          </div>
        </div>
      </div>

      <h2 class="dashboard-section-title">Atalhos</h2>
      <div class="tile-grid mb-4">
        <a class="tile" href="/secretario/agendas">
          <span class="tile-icon"><i class="bi bi-calendar2-plus"></i></span>
          <h3 class="tile-title">Marcar consulta</h3>
          <p class="tile-meta">Para qualquer paciente</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/secretario/pacientes">
          <span class="tile-icon"><i class="bi bi-people"></i></span>
          <h3 class="tile-title">Pacientes</h3>
          <p class="tile-meta"><%= pacientes.length %> registados</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/secretario/lista-espera">
          <span class="tile-icon"><i class="bi bi-hourglass-split"></i></span>
          <h3 class="tile-title">Lista de espera</h3>
          <p class="tile-meta">Vagas e substituições</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/secretario/consultas">
          <span class="tile-icon"><i class="bi bi-calendar3"></i></span>
          <h3 class="tile-title">Consultas</h3>
          <p class="tile-meta">Todas as marcações</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
      </div>

      <div class="dashboard-card">
        <div class="card-header">
          <span><i class="bi bi-calendar-day me-1"></i> Agenda de hoje</span>
          <a class="small text-decoration-none" href="/secretario/agendas">Gerir agendas</a>
        </div>
        <% if (consultasHoje.length) { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
              <thead>
                <tr>
                  <th>Hora</th>
                  <th>Paciente</th>
                  <th class="d-none d-md-table-cell">Médico</th>
                  <th>Estado</th>
                  <th class="text-end">Ação</th>
                </tr>
              </thead>
              <tbody>
                <% consultasHoje.forEach(function (consulta) { %>
                  <tr>
                    <td class="small"><%= formatarHora(consulta.inicio) %></td>
                    <td class="small fw-semibold"><%= consulta.paciente.utilizador.nome %></td>
                    <td class="small d-none d-md-table-cell"><%= consulta.medico.utilizador.nome %></td>
                    <td><span class="badge badge-soft-<%= coresEstado[consulta.estado] %>"><%= rotulosEstado[consulta.estado] %></span></td>
                    <td class="text-end">
                      <a class="btn btn-outline-primary btn-sm" href="/secretario/consultas/<%= consulta.id %>" aria-label="Editar consulta"><i class="bi bi-pencil"></i></a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="dashboard-empty">
            <i class="bi bi-calendar-check"></i>
            <p>Sem consultas hoje.</p>
            <a class="btn btn-ma btn-sm" href="/secretario/agendas">Marcar consulta</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
