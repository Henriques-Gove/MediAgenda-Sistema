<section class="page-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h1 class="h2 mb-1">Todas as consultas</h1>
        <p class="lead mb-0">Acompanhe e intervenha nas marcações da clínica.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-ma" href="/secretario/agendas"><i class="bi bi-calendar2-plus me-1"></i> Nova marcação</a>
        <div class="btn-group">
          <a class="btn btn-outline-secondary" href="/secretario/consultas/exportar.csv?estado=<%= filtros.estado %>&medicoId=<%= filtros.medicoId %>" title="Exportar CSV"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
          <a class="btn btn-outline-secondary" href="/secretario/consultas/exportar.pdf?estado=<%= filtros.estado %>&medicoId=<%= filtros.medicoId %>" title="Exportar PDF"><i class="bi bi-filetype-pdf me-1"></i>PDF</a>
          <a class="btn btn-outline-secondary" href="/secretario/consultas/exportar.ics?medicoId=<%= filtros.medicoId %>" title="Adicionar ao calendário"><i class="bi bi-calendar-plus me-1"></i>.ics</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="pb-5">
  <div class="container">
    <div class="card mb-4">
      <div class="card-body p-3">
        <form action="/secretario/consultas" method="get" class="row g-2 align-items-end">
          <div class="col-6 col-md-4">
            <label class="form-label" for="estado">Estado</label>
            <select class="form-select" id="estado" name="estado" data-auto-submit>
              <option value="">Todos</option>
              <% ['PENDENTE', 'CONFIRMADA', 'REALIZADA', 'CANCELADA'].forEach(function (estado) { %>
                <option value="<%= estado %>" <%= filtros.estado === estado ? 'selected' : '' %>><%= rotulosEstado[estado] %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-6 col-md-5">
            <label class="form-label" for="medicoId">Médico</label>
            <select class="form-select" id="medicoId" name="medicoId" data-auto-submit>
              <option value="">Todos</option>
              <% medicos.forEach(function (medico) { %>
                <option value="<%= medico.id %>" <%= filtros.medicoId === medico.id ? 'selected' : '' %>><%= medico.utilizador.nome %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-outline-ma flex-grow-1" type="submit">Filtrar</button>
            <a class="btn btn-outline-secondary" href="/secretario/consultas" aria-label="Limpar filtros" title="Limpar filtros"><i class="bi bi-arrow-counterclockwise"></i></a>
          </div>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-1"></i> Consultas</span>
        <span class="small text-muted"><%= consultas.length %> registo(s)</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr><th>Data</th><th>Paciente</th><th>Médico</th><th>Estado</th><th class="text-end">Ações</th></tr>
          </thead>
          <tbody>
            <% consultas.forEach(function (consulta) { %>
              <tr>
                <td class="small">
                  <div class="fw-semibold"><%= formatarData(consulta.inicio) %></div>
                  <div class="text-muted"><%= formatarHora(consulta.inicio) %> - <%= formatarHora(consulta.fim) %></div>
                </td>
                <td class="small">
                  <div class="fw-semibold"><%= consulta.paciente.utilizador.nome %></div>
                  <div class="text-muted"><%= consulta.paciente.telefone %></div>
                </td>
                <td class="small">
                  <div class="fw-semibold"><%= consulta.medico.utilizador.nome %></div>
                  <div class="text-muted"><%= consulta.especialidade ? consulta.especialidade.nome : 'Consulta geral' %></div>
                </td>
                <td>
                  <span class="badge badge-soft-<%= coresEstado[consulta.estado] %>"><%= rotulosEstado[consulta.estado] %></span>
                  <% if (consulta.cancelamentoTardio) { %><span class="badge badge-soft-warning">Tardio</span><% } %>
                </td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-1">
                    <% if (consulta.estado === 'PENDENTE' || consulta.estado === 'CONFIRMADA') { %>
                      <button class="btn btn-sm btn-outline-ma" data-bs-toggle="modal" data-bs-target="#reagendar<%= consulta.id %>" title="Reagendar"><i class="bi bi-arrow-repeat"></i></button>
                      <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelar<%= consulta.id %>" title="Cancelar"><i class="bi bi-x-circle"></i></button>
                    <% } %>
                    <% if (consulta.estado === 'CONFIRMADA') { %>
                      <form action="/secretario/consultas/<%= consulta.id %>/realizar" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button class="btn btn-sm btn-ma" type="submit" title="Marcar como realizada"><i class="bi bi-check2"></i></button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
            <% if (!consultas.length) { %>
              <tr><td colspan="5" class="text-center text-muted py-4">Nenhuma consulta encontrada.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination') %>
    </div>
  </div>
</section>

<% consultas.forEach(function (consulta) { %>
  <% if (consulta.estado === 'PENDENTE' || consulta.estado === 'CONFIRMADA') { %>
    <div class="modal fade" id="reagendar<%= consulta.id %>" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" action="/secretario/consultas/<%= consulta.id %>/reagendar" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="modal-header">
            <h5 class="modal-title">Reagendar consulta</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>
          <div class="modal-body">
            <p class="small text-muted">
              <%= consulta.paciente.utilizador.nome %> com <%= consulta.medico.utilizador.nome %> em
              <strong><%= formatarDataHora(consulta.inicio) %></strong>.
            </p>
            <div class="row g-3">
              <div class="col-7">
                <label class="form-label" for="data<%= consulta.id %>">Nova data</label>
                <input class="form-control" id="data<%= consulta.id %>" name="data" type="date" min="<%= formatarDataInput(new Date()) %>" required />
              </div>
              <div class="col-5">
                <label class="form-label" for="hora<%= consulta.id %>">Nova hora</label>
                <input class="form-control" id="hora<%= consulta.id %>" name="hora" type="time" required />
              </div>
            </div>
            <div class="alert alert-info small mt-3 mb-0">
              <i class="bi bi-info-circle me-1"></i>As regras de antecedência e conflito são validadas automaticamente.
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Voltar</button>
            <button type="submit" class="btn btn-ma">Guardar</button>
          </div>
        </form>
      </div>
    </div>

    <div class="modal fade" id="cancelar<%= consulta.id %>" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" action="/secretario/consultas/<%= consulta.id %>/cancelar" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="modal-header">
            <h5 class="modal-title">Cancelar consulta</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>
          <div class="modal-body">
            <p class="small text-muted">
              <%= consulta.paciente.utilizador.nome %> com <%= consulta.medico.utilizador.nome %> em
              <strong><%= formatarDataHora(consulta.inicio) %></strong>.
            </p>
            <label class="form-label" for="motivo<%= consulta.id %>">Motivo</label>
            <textarea class="form-control" id="motivo<%= consulta.id %>" name="motivo" rows="2" minlength="3" required placeholder="Indique o motivo do cancelamento"></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Voltar</button>
            <button type="submit" class="btn btn-danger">Cancelar consulta</button>
          </div>
        </form>
      </div>
    </div>
  <% } %>
<% }); %>
