<section class="page-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h1 class="h2 mb-1">Lista de espera</h1>
        <p class="lead mb-0">Pacientes que aguardam uma vaga compatível com a sua preferência.</p>
      </div>
      <a class="btn btn-outline-ma" href="/secretario/agendas"><i class="bi bi-calendar2-plus me-1"></i> Marcar consulta</a>
    </div>
  </div>
</section>

<section class="pb-5">
  <div class="container">
    <div class="card mb-4">
      <div class="card-body p-3">
        <form action="/secretario/lista-espera" method="get" class="row g-2 align-items-end">
          <div class="col-md-6">
            <label class="form-label" for="medicoId">Médico</label>
            <select class="form-select" id="medicoId" name="medicoId" data-auto-submit>
              <option value="">Todos os médicos</option>
              <% medicos.forEach(function (item) { %>
                <option value="<%= item.id %>" <%= filtroMedicoId === item.id ? 'selected' : '' %>><%= item.utilizador.nome %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-3">
            <a class="btn btn-outline-secondary w-100" href="/secretario/lista-espera"><i class="bi bi-arrow-counterclockwise me-1"></i>Limpar</a>
          </div>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-hourglass-split me-1"></i> Pedidos ativos</span>
        <span class="small text-muted"><%= pedidos.length %> pedido(s)</span>
      </div>
      <div class="card-body p-0">
        <% if (pedidos.length) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th scope="col">Paciente</th>
                  <th scope="col">Médico</th>
                  <th scope="col">Preferência</th>
                  <th scope="col">Pedido em</th>
                  <th scope="col" class="text-end">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% pedidos.forEach(function (pedido) { %>
                  <tr>
                    <td>
                      <div class="fw-semibold"><%= pedido.paciente.utilizador.nome %></div>
                      <div class="small text-muted"><%= pedido.paciente.telefone %> · <%= pedido.paciente.utilizador.email %></div>
                    </td>
                    <td class="small">
                      <div><%= pedido.medico.utilizador.nome %></div>
                      <div class="text-muted"><%= pedido.especialidade ? pedido.especialidade.nome : 'Qualquer especialidade' %></div>
                    </td>
                    <td class="small">
                      <% if (pedido.dataPreferida) { %><div><i class="bi bi-calendar3 me-1"></i><%= formatarData(pedido.dataPreferida) %></div><% } %>
                      <% if (pedido.periodo) { %><div class="text-muted"><i class="bi bi-clock me-1"></i><%= pedido.periodo === 'MANHA' ? 'Manhã' : pedido.periodo === 'TARDE' ? 'Tarde' : 'Dia inteiro' %></div><% } %>
                      <% if (!pedido.dataPreferida && !pedido.periodo) { %><span class="text-muted">Sem preferência</span><% } %>
                    </td>
                    <td class="small text-muted"><%= formatarData(pedido.criadoEm) %></td>
                    <td class="text-end">
                      <div class="d-flex justify-content-end gap-1">
                        <a class="btn btn-sm btn-outline-ma" href="/secretario/agendas?medicoId=<%= pedido.medicoId %>&data=<%= pedido.dataPreferida ? formatarDataInput(pedido.dataPreferida) : formatarDataInput(new Date()) %>" title="Abrir agenda do médico">
                          <i class="bi bi-calendar2-week"></i>
                        </a>
                        <form action="/secretario/lista-espera/<%= pedido.id %>/cancelar" method="post" data-confirm="Remover este pedido da lista de espera?">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button class="btn btn-sm btn-outline-danger" type="submit" title="Remover pedido"><i class="bi bi-x-lg"></i></button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state py-5">
            <i class="bi bi-hourglass"></i>
            <p class="fw-semibold mb-1">Sem pedidos ativos</p>
            <p class="small mb-0">Os pedidos dos pacientes aparecem aqui.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
