<section class="page-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h1 class="h2 mb-1">Especialidades</h1>
        <p class="lead mb-0">Crie, edite e active/desactive as áreas médicas da clínica.</p>
      </div>
      <button class="btn btn-ma" data-bs-toggle="collapse" data-bs-target="#novaEspecialidade">
        <i class="bi bi-plus-circle me-1"></i> Nova especialidade
      </button>
    </div>
  </div>
</section>

<section class="pb-5">
  <div class="container">
    <div class="collapse mb-4" id="novaEspecialidade">
      <div class="card">
        <div class="card-header"><i class="bi bi-plus-circle me-1"></i> Criar especialidade</div>
        <div class="card-body p-4">
          <form action="/admin/especialidades" method="post" class="row g-3 align-items-end">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="col-md-4">
              <label class="form-label" for="nome">Nome</label>
              <input class="form-control" id="nome" name="nome" type="text" required />
            </div>
            <div class="col-md-2">
              <label class="form-label" for="duracaoPadraoMinutos">Duração (min)</label>
              <input class="form-control" id="duracaoPadraoMinutos" name="duracaoPadraoMinutos" type="number" min="60" max="120" step="15" value="60" required />
            </div>
            <div class="col-md-4">
              <label class="form-label" for="descricao">Descrição</label>
              <input class="form-control" id="descricao" name="descricao" type="text" maxlength="300" />
            </div>
            <div class="col-md-2">
              <button class="btn btn-ma w-100" type="submit">Criar</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-tags me-1"></i> Lista de especialidades</span>
        <span class="small text-muted"><%= especialidades.length %> registo(s)</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr><th>Nome</th><th>Descrição</th><th>Duração</th><th>Médicos</th><th>Consultas</th><th>Estado</th><th class="text-end">Ações</th></tr>
          </thead>
          <tbody>
            <% especialidades.forEach(function (especialidade) { %>
              <tr>
                <td class="fw-semibold small"><%= especialidade.nome %></td>
                <td class="small text-muted"><%= especialidade.descricao || '-' %></td>
                <td class="small"><%= especialidade.duracaoPadraoMinutos %> min</td>
                <td class="small"><%= especialidade._count.medicos %></td>
                <td class="small"><%= especialidade._count.consultas %></td>
                <td>
                  <span class="badge badge-soft-<%= especialidade.ativa ? 'success' : 'secondary' %>"><%= especialidade.ativa ? 'Ativa' : 'Inativa' %></span>
                </td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-1">
                    <button class="btn btn-sm btn-outline-ma" data-bs-toggle="modal" data-bs-target="#editar<%= especialidade.id %>" title="Editar"><i class="bi bi-pencil"></i></button>
                    <% if (especialidade.ativa) { %>
                      <form action="/admin/especialidades/<%= especialidade.id %>/desativar" method="post" data-confirm="Desativar esta especialidade?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Desactivar"><i class="bi bi-slash-circle"></i></button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
            <% if (!especialidades.length) { %>
              <tr><td colspan="7" class="text-center text-muted py-4">Ainda sem especialidades.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<% especialidades.forEach(function (especialidade) { %>
  <div class="modal fade" id="editar<%= especialidade.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <form class="modal-content" action="/admin/especialidades/<%= especialidade.id %>" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="modal-header">
          <h5 class="modal-title">Editar especialidade</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label" for="nome<%= especialidade.id %>">Nome</label>
            <input class="form-control" id="nome<%= especialidade.id %>" name="nome" type="text" value="<%= especialidade.nome %>" required />
          </div>
          <div class="mb-3">
            <label class="form-label" for="desc<%= especialidade.id %>">Descrição</label>
            <input class="form-control" id="desc<%= especialidade.id %>" name="descricao" type="text" value="<%= especialidade.descricao || '' %>" />
          </div>
          <div class="mb-3">
            <label class="form-label" for="dur<%= especialidade.id %>">Duração (min)</label>
            <input class="form-control" id="dur<%= especialidade.id %>" name="duracaoPadraoMinutos" type="number" min="60" max="120" step="15" value="<%= especialidade.duracaoPadraoMinutos %>" required />
          </div>
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="ativa<%= especialidade.id %>" name="ativa" <%= especialidade.ativa ? 'checked' : '' %> />
            <label class="form-check-label" for="ativa<%= especialidade.id %>">Especialidade ativa</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-ma">Guardar</button>
        </div>
      </form>
    </div>
  </div>
<% }); %>
