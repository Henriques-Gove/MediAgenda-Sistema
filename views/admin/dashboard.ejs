<section class="dashboard-page dashboard-admin">
  <div class="dashboard-bg"></div>
  <div class="dashboard-scene" aria-hidden="true">
    <i class="bi bi-shield-check"></i>
    <i class="bi bi-graph-up"></i>
    <i class="bi bi-people"></i>
    <i class="bi bi-gear"></i>
  </div>

  <div class="dashboard-shell">
    <header class="dashboard-header">
      <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
          <div>
            <span class="dashboard-eyebrow"><i class="bi bi-shield-check"></i> Administração</span>
            <h1>Painel</h1>
            <p class="dashboard-lead">Visão geral dos últimos 30 dias.</p>
          </div>
          <div class="d-flex flex-column flex-sm-row gap-2">
            <a class="btn btn-outline-ma" href="/admin/relatorios"><i class="bi bi-bar-chart me-1"></i> Relatórios</a>
            <a class="btn btn-ma" href="/admin/utilizadores"><i class="bi bi-people me-1"></i> Utilizadores</a>
          </div>
        </div>
      </div>
    </header>

    <div class="container pb-5">
      <div class="row g-2 g-md-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-total"><i class="bi bi-calendar2-week"></i></span>
            <div>
              <div class="stat-value"><%= resumo.totalConsultas %></div>
              <div class="stat-label">Consultas (30d)</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-realizadas"><i class="bi bi-check2-circle"></i></span>
            <div>
              <div class="stat-value"><%= resumo.realizadas %></div>
              <div class="stat-label">Realizadas</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-canceladas"><i class="bi bi-x-circle"></i></span>
            <div>
              <div class="stat-value"><%= resumo.canceladas %></div>
              <div class="stat-label">Canceladas</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <span class="stat-icon stat-icon-ocupacao"><i class="bi bi-speedometer2"></i></span>
            <div>
              <div class="stat-value"><%= resumo.taxaOcupacao %>%</div>
              <div class="stat-label">Ocupação</div>
            </div>
          </div>
        </div>
      </div>

      <h2 class="dashboard-section-title">Hoje</h2>
      <div class="row g-2 g-md-3 mb-4">
        <div class="col-4">
          <div class="stat-card">
            <div>
              <div class="stat-value"><%= hoje.consultasHoje %></div>
              <div class="stat-label">Consultas</div>
            </div>
          </div>
        </div>
        <div class="col-4">
          <div class="stat-card">
            <div>
              <div class="stat-value text-success"><%= hoje.confirmadasHoje %></div>
              <div class="stat-label">Confirmadas</div>
            </div>
          </div>
        </div>
        <div class="col-4">
          <div class="stat-card">
            <div>
              <div class="stat-value text-danger"><%= hoje.canceladasHoje %></div>
              <div class="stat-label">Canceladas</div>
            </div>
          </div>
        </div>
      </div>

      <h2 class="dashboard-section-title">Gestão</h2>
      <div class="tile-grid mb-4">
        <a class="tile" href="/admin/utilizadores">
          <span class="tile-icon"><i class="bi bi-people"></i></span>
          <h3 class="tile-title">Utilizadores</h3>
          <p class="tile-meta">Contas e perfis</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/admin/medicos">
          <span class="tile-icon"><i class="bi bi-person-badge"></i></span>
          <h3 class="tile-title">Médicos</h3>
          <p class="tile-meta">Equipa clínica</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/admin/especialidades">
          <span class="tile-icon"><i class="bi bi-tags"></i></span>
          <h3 class="tile-title">Especialidades</h3>
          <p class="tile-meta">Catálogo da clínica</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
        <a class="tile" href="/admin/relatorios">
          <span class="tile-icon"><i class="bi bi-bar-chart"></i></span>
          <h3 class="tile-title">Relatórios</h3>
          <p class="tile-meta">Ocupação e cancelamentos</p>
          <i class="bi bi-arrow-right tile-arrow"></i>
        </a>
      </div>

      <div class="row g-3 g-lg-4">
        <div class="col-lg-7">
          <div class="dashboard-card">
            <div class="card-header">
              <span><i class="bi bi-envelope me-1"></i> Notificações</span>
              <a class="small text-decoration-none" href="/admin/notificacoes">Ver todas</a>
            </div>
            <div class="table-responsive">
              <table class="table table-hover mb-0 align-middle">
                <thead><tr><th>Destino</th><th class="d-none d-md-table-cell">Canal</th><th>Estado</th><th class="d-none d-md-table-cell">Data</th></tr></thead>
                <tbody>
                  <% notificacoes.forEach(function (notificacao) { %>
                    <tr>
                      <td class="small"><%= notificacao.destinatario %></td>
                      <td class="d-none d-md-table-cell"><span class="badge badge-soft-secondary"><%= notificacao.canal %></span></td>
                      <td><span class="badge badge-soft-<%= notificacao.estado === 'FALHADA' ? 'danger' : notificacao.estado === 'SIMULADA' ? 'warning' : 'success' %>"><%= notificacao.estado %></span></td>
                      <td class="small text-muted d-none d-md-table-cell"><%= formatarDataHora(notificacao.enviadoEm) %></td>
                    </tr>
                  <% }); %>
                  <% if (!notificacoes.length) { %>
                    <tr><td colspan="4" class="text-center text-muted small py-4">Sem notificações.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="dashboard-card">
            <div class="card-header">
              <span><i class="bi bi-star me-1"></i> Avaliações</span>
              <a class="small text-decoration-none" href="/admin/avaliacoes">Ver todas</a>
            </div>
            <div class="card-body">
              <% avaliacoes.forEach(function (avaliacao) { %>
                <div class="d-flex gap-2 py-2 border-bottom">
                  <span class="avatar avatar-sm"><%= avaliacao.paciente.utilizador.nome.charAt(0).toUpperCase() %></span>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between gap-1">
                      <span class="small fw-semibold"><%= avaliacao.medico.utilizador.nome %></span>
                      <span class="rating small">
                        <% for (let i = 1; i <= 5; i += 1) { %><i class="bi <%= i <= avaliacao.estrelas ? 'bi-star-fill' : 'bi-star' %>"></i><% } %>
                      </span>
                    </div>
                    <% if (avaliacao.comentario) { %><div class="small text-muted"><%= avaliacao.comentario %></div><% } %>
                  </div>
                </div>
              <% }); %>
              <% if (!avaliacoes.length) { %><p class="small text-muted mb-0">Sem avaliações registadas.</p><% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
