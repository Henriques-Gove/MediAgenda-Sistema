<section class="dashboard-page dashboard-admin">
  <div class="dashboard-bg"></div>

  <div class="dashboard-shell">
    <header class="dashboard-header">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <span class="badge badge-soft-primary mb-2">Administração</span>
          <h1 class="h2 mb-1">Painel do administrador</h1>
          <p class="lead mb-0">Visão geral da clínica e gestão de utilizadores.</p>
        </div>
        <div class="d-flex gap-2">
          <a class="btn btn-outline-ma" href="/admin/relatorios"><i class="bi bi-bar-chart me-1"></i> Relatórios</a>
          <a class="btn btn-ma" href="/admin/utilizadores"><i class="bi bi-people me-1"></i> Utilizadores</a>
        </div>
      </div>
    </header>

    <div class="dashboard-body container pb-5">
      <!-- Estatísticas rápidas -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <span class="stat-icon stat-icon-total"><i class="bi bi-calendar2-week"></i></span>
              <div>
                <div class="stat-value"><%= resumo.totalConsultas %></div>
                <div class="stat-label">Consultas (30d)</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <span class="stat-icon stat-icon-realizadas"><i class="bi bi-check2-circle"></i></span>
              <div>
                <div class="stat-value"><%= resumo.realizadas %></div>
                <div class="stat-label">Realizadas</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <span class="stat-icon stat-icon-canceladas"><i class="bi bi-x-circle"></i></span>
              <div>
                <div class="stat-value"><%= resumo.canceladas %></div>
                <div class="stat-label">Canceladas</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <span class="stat-icon stat-icon-ocupacao"><i class="bi bi-speedometer2"></i></span>
              <div>
                <div class="stat-value"><%= resumo.taxaOcupacao %>%</div>
                <div class="stat-label">Ocupação</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Hoje -->
      <div class="row g-3 mb-4">
        <div class="col-md-3">
          <div class="card h-100 stat-card-moderno">
            <div class="card-body p-3 text-center">
              <div class="small text-muted">Hoje</div>
              <div class="fs-4 fw-bold text-success"><%= hoje.consultasHoje %></div>
              <div class="small text-muted">consultas</div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card h-100 stat-card-moderno">
            <div class="card-body p-3 text-center">
              <div class="small text-muted">Confirmadas hoje</div>
              <div class="fs-4 fw-bold text-success"><%= hoje.confirmadasHoje %></div>
              <div class="small text-muted">consultas</div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card h-100 stat-card-moderno">
            <div class="card-body p-3 text-center">
              <div class="small text-muted">Canceladas hoje</div>
              <div class="fs-4 fw-bold text-danger"><%= hoje.canceladasHoje %></div>
              <div class="small text-muted">consultas</div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card h-100 stat-card-moderno">
            <div class="card-body p-3 text-center">
              <div class="small text-muted">Novos pacientes</div>
              <div class="fs-4 fw-bold text-primary"><%= hoje.novosPacientes %></div>
              <div class="small text-muted">hoje</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tiles de gestão principal -->
      <div class="dashboard-tiles row g-4 mb-4">
        <div class="col-12 col-lg-6 col-xl-4">
          <div class="tile tile-utilizadores" data-tile="utilizadores">
            <div class="tile-front">
              <div class="tile-icon"><i class="bi bi-people"></i></div>
              <h3 class="tile-title">Utilizadores</h3>
              <p class="tile-subtitle">Criar, editar e promover contas da equipa</p>
              <span class="tile-badge">Gestão de acessos</span>
            </div>
            <div class="tile-back">
              <i class="bi bi-arrow-right-circle"></i>
              <span>Gerir utilizadores</span>
            </div>
            <a class="tile-link" href="/admin/utilizadores"></a>
          </div>
        </div>
        <div class="col-12 col-lg-6 col-xl-4">
          <div class="tile tile-especialidades" data-tile="especialidades">
            <div class="tile-front">
              <div class="tile-icon"><i class="bi bi-tag"></i></div>
              <h3 class="tile-title">Especialidades</h3>
              <p class="tile-subtitle">CRUD de especialidades da clínica</p>
              <span class="tile-badge">Catálogo</span>
            </div>
            <div class="tile-back">
              <i class="bi bi-arrow-right-circle"></i>
              <span>Gerir especialidades</span>
            </div>
            <a class="tile-link" href="/admin/especialidades"></a>
          </div>
        </div>
        <div class="col-12 col-lg-4 col-xl-4">
          <div class="tile tile-relatorios" data-tile="relatorios">
            <div class="tile-front">
              <div class="tile-icon"><i class="bi bi-bar-chart"></i></div>
              <h3 class="tile-title">Relatórios</h3>
              <p class="tile-subtitle">Ocupação, cancelamentos e satisfação</p>
              <span class="tile-badge">Estatísticas</span>
            </div>
            <div class="tile-back">
              <i class="bi bi-arrow-right-circle"></i>
              <span>Ver relatórios</span>
            </div>
            <a class="tile-link" href="/admin/relatorios"></a>
          </div>
        </div>
      </div>

      <!-- Área principal: EDA + Notificações + Avaliações -->
      <div class="row g-4">
        <div class="col-lg-8">
          <div class="card dashboard-card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span><i class="bi bi-broadcast me-1"></i> Atividade do sistema (EDA)</span>
              <span class="badge badge-soft-primary"><%= eventos.total %> evento(s)</span>
            </div>
            <div class="card-body">
              <% if (eventos.ultimos.length) { %>
                <div class="d-flex flex-wrap gap-1 mb-3">
                  <% Object.keys(eventos.porTipo).forEach(function (tipo) { %>
                    <span class="badge badge-soft-info"><%= tipo %>: <%= eventos.porTipo[tipo] %></span>
                  <% }); %>
                </div>
                <div class="timeline">
                  <% eventos.ultimos.slice(0, 8).forEach(function (evento) { %>
                    <div class="timeline-item">
                      <div class="d-flex justify-content-between flex-wrap gap-1">
                        <span class="small fw-semibold"><%= evento.tipo %></span>
                        <span class="small text-muted"><%= formatarDataHora(evento.em) %></span>
                      </div>
                      <% if (evento.consultaId) { %>
                        <div class="small text-muted mono"><%= evento.consultaId %></div>
                      <% } %>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <p class="small text-muted mb-0">Ainda sem eventos nesta sessão. As ações dos utilizadores aparecem aqui.</p>
              <% } %>
            </div>
          </div>

          <div class="card dashboard-card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span><i class="bi bi-envelope me-1"></i> Notificações recentes</span>
              <a class="small text-decoration-none" href="/admin/notificacoes">Ver todas</a>
            </div>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead><tr><th>Destinatário</th><th>Canal</th><th>Assunto</th><th>Estado</th><th>Data</th></tr></thead>
                <tbody>
                  <% notificacoes.forEach(function (notificacao) { %>
                    <tr>
                      <td class="small"><%= notificacao.destinatario %></td>
                      <td><span class="badge badge-soft-secondary"><%= notificacao.canal %></span></td>
                      <td class="small"><%= notificacao.assunto %></td>
                      <td><span class="badge badge-soft-<%= notificacao.estado === 'FALHADA' ? 'danger' : notificacao.estado === 'SIMULADA' ? 'warning' : 'success' %>"><%= notificacao.estado %></span></td>
                      <td class="small text-muted"><%= formatarDataHora(notificacao.enviadoEm) %></td>
                    </tr>
                  <% }); %>
                  <% if (!notificacoes.length) { %>
                    <tr><td colspan="5" class="text-center text-muted small py-4">Sem notificações.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="card dashboard-card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span><i class="bi bi-star me-1"></i> Avaliações recentes</span>
              <a class="small text-decoration-none" href="/admin/avaliacoes">Ver todas</a>
            </div>
            <div class="card-body">
              <% avaliacoes.forEach(function (avaliacao) { %>
                <div class="d-flex gap-3 py-2 border-bottom">
                  <span class="avatar avatar-sm"><%= avaliacao.paciente.utilizador.nome.charAt(0).toUpperCase() %></span>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between flex-wrap gap-1">
                      <span class="small fw-semibold"><%= avaliacao.paciente.utilizador.nome %> &rarr; <%= avaliacao.medico.utilizador.nome %></span>
                      <span class="rating small">
                        <% for (let i = 1; i <= 5; i += 1) { %><i class="bi <%= i <= avaliacao.estrelas ? 'bi-star-fill' : 'bi-star' %>"></i><% } %>
                      </span>
                    </div>
                    <% if (avaliacao.comentario) { %><div class="small text-muted"><%= avaliacao.comentario %></div><% } %>
                  </div>
                </div>
              <% }); %>
              <% if (!avaliacoes.length) { %><p class="small text-muted mb-0">Sem avaliações registadas.</p><% } %>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="card dashboard-card">
            <div class="card-header"><i class="bi bi-shield-check me-1"></i> Segurança e acesso</div>
            <div class="card-body">
              <div class="alert alert-info small mb-0 p-3">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Notas:</strong> pacientes criam a própria conta em <em>/registo</em>. Médicos e secretários são criados pelo administrador ou secretário. Use a tabela de Utilizadores para promover contas a secretário ou administrador.
              </div>
            </div>
          </div>

          <div class="card dashboard-card">
            <div class="card-header"><i class="bi bi-sliders me-1"></i> Configurações</div>
            <div class="card-body">
              <a class="btn btn-outline-ma w-100 mb-2" href="/admin/configuracoes"><i class="bi bi-gear me-1"></i> Configurações da clínica</a>
              <a class="btn btn-outline-ma w-100" href="/admin/auditoria"><i class="bi bi-journal-text me-1"></i> Auditoria de ações</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dashboard-admin .dashboard-bg {
    background:
      radial-gradient(circle at 25% 35%, rgba(107, 114, 128, 0.2), transparent 45%),
      radial-gradient(circle at 85% 80%, rgba(75, 85, 99, 0.15), transparent 50%),
      linear-gradient(135deg, #f8fafc 0%, #e2e8f0 60%, #cbd5e1 100%);
  }
  .dashboard-admin .stat-icon-total { background: #e2e8f0; color: #475569; }
  .dashboard-admin .stat-icon-realizadas { background: #d1fae5; color: #059669; }
  .dashboard-admin .stat-icon-canceladas { background: #fee2e2; color: #dc2626; }
  .dashboard-admin .stat-icon-ocupacao { background: #bfdbfe; color: #2563eb; }
  .dashboard-admin .tile-icon { color: #475569; background: #e2e8f0; }
  .dashboard-admin .tile-back { background: linear-gradient(135deg, #475569 0%, #334155 100%); }
  .stat-card-moderno { border-radius: 1rem; border: 1px solid var(--ma-border); box-shadow: 0 10px 25px -15px rgba(15, 23, 42, 0.1); }

  .dashboard-admin .form-select { font-size: 0.85rem; }
</style>

