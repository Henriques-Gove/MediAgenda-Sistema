<section class="page-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <span class="badge badge-soft-primary mb-2">Administração</span>
        <h1 class="h2 mb-1">Painel do administrador</h1>
        <p class="lead mb-0">Visão geral dos últimos 30 dias e atividade em tempo real.</p>
      </div>
      <div class="d-flex gap-2">
        <a class="btn btn-outline-ma" href="/admin/relatorios"><i class="bi bi-bar-chart me-1"></i> Relatórios</a>
        <a class="btn btn-ma" href="/admin/configuracoes"><i class="bi bi-sliders me-1"></i> Configurações</a>
      </div>
    </div>
  </div>
</section>

<section class="pb-5">
  <div class="container">
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex align-items-center gap-3">
            <span class="stat-icon"><i class="bi bi-calendar2-week"></i></span>
            <div><div class="stat-value"><%= resumo.totalConsultas %></div><div class="stat-label">Consultas (30d)</div></div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex align-items-center gap-3">
            <span class="stat-icon"><i class="bi bi-check2-circle"></i></span>
            <div><div class="stat-value"><%= resumo.realizadas %></div><div class="stat-label">Realizadas</div></div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex align-items-center gap-3">
            <span class="stat-icon"><i class="bi bi-x-circle"></i></span>
            <div><div class="stat-value"><%= resumo.canceladas %></div><div class="stat-label">Canceladas</div></div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex align-items-center gap-3">
            <span class="stat-icon"><i class="bi bi-speedometer2"></i></span>
            <div><div class="stat-value"><%= resumo.taxaOcupacao %>%</div><div class="stat-label">Ocupação</div></div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body p-3 text-center">
            <div class="small text-muted">Hoje</div>
            <div class="fs-4 fw-bold"><%= hoje.consultasHoje %></div>
            <div class="small text-muted">consultas</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body p-3 text-center">
            <div class="small text-muted">Confirmadas hoje</div>
            <div class="fs-4 fw-bold text-success"><%= hoje.confirmadasHoje %></div>
            <div class="small text-muted">consultas</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body p-3 text-center">
            <div class="small text-muted">Canceladas hoje</div>
            <div class="fs-4 fw-bold text-danger"><%= hoje.canceladasHoje %></div>
            <div class="small text-muted">consultas</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body p-3 text-center">
            <div class="small text-muted">Novos pacientes</div>
            <div class="fs-4 fw-bold text-primary"><%= hoje.novosPacientes %></div>
            <div class="small text-muted">hoje</div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-broadcast me-1"></i> Atividade EDA em tempo real</span>
            <span class="badge badge-soft-primary"><%= eventos.total %> evento(s)</span>
          </div>
          <div class="card-body">
            <% if (eventos.ultimos.length) { %>
              <div class="d-flex flex-wrap gap-1 mb-3">
                <% Object.keys(eventos.porTipo).forEach(function (tipo) { %>
                  <span class="badge badge-soft-info"><%= tipo %>: <%= eventos.porTipo[tipo] %></span>
                <% }); %>
              </div>
              <div class="timeline">
                <% eventos.ultimos.slice(0, 8).forEach(function (evento) { %>
                  <div class="timeline-item">
                    <div class="d-flex justify-content-between flex-wrap gap-1">
                      <span class="small fw-semibold"><%= evento.tipo %></span>
                      <span class="small text-muted"><%= formatarDataHora(evento.em) %></span>
                    </div>
                    <% if (evento.consultaId) { %>
                      <div class="small text-muted mono"><%= evento.consultaId %></div>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p class="small text-muted mb-0">Ainda sem eventos nesta sessão. As ações dos utilizadores aparecem aqui.</p>
            <% } %>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-envelope me-1"></i> Notificações recentes</span>
            <a class="small text-decoration-none" href="/admin/notificacoes">Ver todas</a>
          </div>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead><tr><th>Destinatario</th><th>Canal</th><th>Assunto</th><th>Estado</th><th>Data</th></tr></thead>
              <tbody>
                <% notificacoes.forEach(function (notificacao) { %>
                  <tr>
                    <td class="small"><%= notificacao.destinatario %></td>
                    <td><span class="badge badge-soft-secondary"><%= notificacao.canal %></span></td>
                    <td class="small"><%= notificacao.assunto %></td>
                    <td><span class="badge badge-soft-<%= notificacao.estado === 'FALHADA' ? 'danger' : notificacao.estado === 'SIMULADA' ? 'warning' : 'success' %>"><%= notificacao.estado %></span></td>
                    <td class="small text-muted"><%= formatarDataHora(notificacao.enviadoEm) %></td>
                  </tr>
                <% }); %>
                <% if (!notificacoes.length) { %>
                  <tr><td colspan="5" class="text-center text-muted small py-4">Sem notificações.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-star me-1"></i> Avaliações recentes</span>
            <a class="small text-decoration-none" href="/admin/avaliacoes">Ver todas</a>
          </div>
          <div class="card-body">
            <% avaliacoes.forEach(function (avaliacao) { %>
              <div class="d-flex gap-3 py-2 border-bottom">
                <span class="avatar avatar-sm"><%= avaliacao.paciente.utilizador.nome.charAt(0).toUpperCase() %></span>
                <div class="flex-grow-1">
                  <div class="d-flex justify-content-between flex-wrap gap-1">
                    <span class="small fw-semibold"><%= avaliacao.paciente.utilizador.nome %> &rarr; <%= avaliacao.medico.utilizador.nome %></span>
                    <span class="rating small">
                      <% for (let i = 1; i <= 5; i += 1) { %><i class="bi <%= i <= avaliacao.estrelas ? 'bi-star-fill' : 'bi-star' %>"></i><% } %>
                    </span>
                  </div>
                  <% if (avaliacao.comentario) { %><div class="small text-muted"><%= avaliacao.comentario %></div><% } %>
                </div>
              </div>
            <% }); %>
            <% if (!avaliacoes.length) { %><p class="small text-muted mb-0">Sem avaliações registadas.</p><% } %>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card mb-4">
          <div class="card-header"><i class="bi bi-speedometer me-1"></i> Indicadores</div>
          <div class="card-body">
            <div class="mb-3">
              <div class="d-flex justify-content-between small mb-1"><span class="text-muted">Taxa de cancelamento</span><span class="fw-semibold"><%= resumo.taxaCancelamento %>%</span></div>
              <div class="progress"><div class="progress-bar" style="width: <%= Math.min(100, resumo.taxaCancelamento) %>%"></div></div>
            </div>
            <div class="mb-3">
              <div class="d-flex justify-content-between small mb-1"><span class="text-muted">Taxa de ocupação</span><span class="fw-semibold"><%= resumo.taxaOcupacao %>%</span></div>
              <div class="progress"><div class="progress-bar" style="width: <%= Math.min(100, resumo.taxaOcupacao) %>%"></div></div>
            </div>
            <div class="d-flex justify-content-between py-2 border-top small">
              <span class="text-muted">Médicos ativos</span><span class="fw-semibold"><%= resumo.medicosAtivos %></span>
            </div>
            <div class="d-flex justify-content-between py-2 border-top small">
              <span class="text-muted">Capacidade estimada</span><span class="fw-semibold"><%= resumo.capacidadeEstimada %></span>
            </div>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-header"><i class="bi bi-calendar3 me-1"></i> Consultas por mês</div>
          <div class="card-body">
            <%- include('../partials/grafico-barras', {
              dados: resumo.consultasPorMes.map(function (item) {
                return { rotulo: item.mes.slice(5) + '/' + item.mes.slice(2, 4), valor: item.total };
              }),
              titulo: 'Consultas por mês'
            }) %>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-header"><i class="bi bi-tags me-1"></i> Consultas por especialidade</div>
          <div class="card-body">
            <% resumo.consultasPorEspecialidade.slice(0, 6).forEach(function (item) { %>
              <div class="d-flex justify-content-between small py-1 border-bottom">
                <span><%= item.especialidade %></span><span class="fw-semibold"><%= item.total %></span>
              </div>
            <% }); %>
            <% if (!resumo.consultasPorEspecialidade.length) { %><p class="small text-muted mb-0">Sem dados no período.</p><% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="bi bi-lightning-charge me-1"></i> Ações rápidas</div>
          <div class="list-group list-group-flush">
            <a class="list-group-item list-group-item-action" href="/admin/especialidades"><i class="bi bi-tags me-2 text-success"></i>Gerir especialidades</a>
            <a class="list-group-item list-group-item-action" href="/admin/medicos"><i class="bi bi-person-badge me-2 text-success"></i>Gerir médicos</a>
            <a class="list-group-item list-group-item-action" href="/admin/utilizadores"><i class="bi bi-people me-2 text-success"></i>Gerir utilizadores</a>
            <a class="list-group-item list-group-item-action" href="/admin/auditoria"><i class="bi bi-shield-check me-2 text-success"></i>Consultar auditoria</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
