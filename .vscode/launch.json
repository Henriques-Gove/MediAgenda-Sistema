{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MediAgenda - Desenvolvimento (tsx)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": ["src/server.ts"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development",
        "PORT": "3101",
        "APP_URL": "http://localhost:3101",
        "DATABASE_URL": "postgresql://mediagenda:mediagenda@127.0.0.1:5433/mediagenda?schema=public",
        "LOG_LEVEL": "debug"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "MediAgenda - Produção (dist)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/server.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3101",
        "DATABASE_URL": "postgresql://mediagenda:mediagenda@127.0.0.1:5433/mediagenda?schema=public"
      },
      "console": "integratedTerminal",
      "preLaunchTask": "build",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": []
}
