# Copie este ficheiro para .env e preencha os valores.
# Ambiente
NODE_ENV=development
PORT=3101
APP_URL=http://localhost:3101
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Base de dados PostgreSQL (o docker-compose sobe este servico).
# Exemplo local:
DATABASE_URL="postgresql://mediagenda:mediagenda@127.0.0.1:5433/mediagenda?schema=public"
# Exemplo Render/Neon (copie a connection string do painel):
# DATABASE_URL="postgresql://utilizador:senha@host/base?sslmode=require"

# E-mail (SMTP). Se SMTP_HOST estiver vazio, o envio e simulado e registado em consola/BD.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediAgenda <no-reply@mediagenda.co.mz>"

# Confirmacao de e-mail no registo publico.
# So e exigida quando existe SMTP real; sem SMTP a conta fica confirmada
# automaticamente para o paciente poder entrar logo apos o registo.
REQUIRE_EMAIL_CONFIRMATION=false

# SMS (API externa). Se SMS_API_URL estiver vazio, o envio e simulado.
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=MediAgenda

# Desativar os limites de pedidos (util para testes de carga). Em producao deixe 0.
RATE_LIMIT_DISABLED=0
