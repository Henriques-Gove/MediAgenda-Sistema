# Copie este ficheiro para .env e preencha os valores.
# Ambiente
NODE_ENV=development
PORT=3101
APP_URL=http://localhost:3101
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Base de dados (SQLite)
DATABASE_URL="file:./dev.db"

# E-mail (SMTP). Se SMTP_HOST estiver vazio, o envio e simulado e registado em consola/BD.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediAgenda <no-reply@mediagenda.co.mz>"

# SMS (API externa). Se SMS_API_URL estiver vazio, o envio e simulado.
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=MediAgenda
